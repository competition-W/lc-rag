{"docstore/ref_doc_info": {"686622b5-2a39-4e53-b66a-0b657343c5ec": {"node_ids": ["aa21ef16-2088-4dc1-9496-4865aa93142c", "56d89ce7-2f5f-4f40-aa6d-ce9df7020500", "e1d282fc-effa-435b-be90-3054a888dd58", "6be6f743-67d1-402d-b8e3-e814a736f241", "1bba08a8-c770-46cd-8c5e-09bfbf485abb", "9d56ec5b-8ee2-46e7-a6e6-ab3abab7ff3a"], "metadata": {"filename": "example_for_shap_0707.md", "extension": ".md"}}}, "docstore/data": {"aa21ef16-2088-4dc1-9496-4865aa93142c": {"__data__": {"id_": "aa21ef16-2088-4dc1-9496-4865aa93142c", "embedding": null, "metadata": {"filename": "example_for_shap_0707.md", "extension": ".md"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "686622b5-2a39-4e53-b66a-0b657343c5ec", "node_type": "4", "metadata": {"filename": "example_for_shap_0707.md", "extension": ".md"}, "hash": "e4ff5a381b1ddaf9938e7c41d6432c2b90df298e7ccc742dde9d47453ae4a7fc", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "56d89ce7-2f5f-4f40-aa6d-ce9df7020500", "node_type": "1", "metadata": {}, "hash": "ab1420695a661457c663cd77ef93a4f6fc847b543f2ee8792af355cb3b3df44b", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "# \u673a\u5668\u5b66\u4e60\u7ed3\u679c\u89e3\u8bfb\n\n# **Confusion Matrix \u6df7\u6dc6\u77e9\u9635**\n\n## 1. \u4ec0\u4e48\u662f\u6df7\u6dc6\u77e9\u9635?\n\n\u6df7\u6dc6\u77e9\u9635(Confusion Matrix)\u662f\u673a\u5668\u5b66\u4e60\u4e2d\u2f64\u4e8e\u8bc4\u4f30\u5206\u7c7b\u6a21\u578b\u6027\u80fd\u7684\u2f00\u79cd\u8868\u683c\u5e03\u5c40\u2f2f\u5177\u3002\u5b83 \u4ee5\u76f4\u89c2\u7684\u2f45\u5f0f\u5c55\u793a\u4e86\u6a21\u578b\u9884\u6d4b\u7ed3\u679c\u4e0e\u5b9e\u9645\u60c5\u51b5\u4e4b\u95f4\u7684\u5bf9\u5e94\u5173\u7cfb,\u7279\u522b\u9002\u2f64\u4e8e\u2f06\u5206\u7c7b\u95ee\u9898(\u4f46\u4e5f \u53ef\u6269\u5c55\u5230\u591a\u5206\u7c7b)\u3002\n\n## 2. \u6df7\u6dc6\u77e9\u9635\u7ed3\u6784\n\n\u60f3\u8c61\u5b83\u662f\u2f00\u4e2a\u6b63\u2f45\u5f62\u7684\u683c\u2f26,\u2f8f\u548c\u5217\u7684\u6570\u91cf\u53d6\u51b3\u4e8e\u5206\u7c7b\u95ee\u9898\u7684\u7c7b\u522b\u6570\u3002\u5bf9\u4e8e\u6700\u7b80\u5355\u7684\u2f06\u5206\u7c7b\u95ee \u9898(\u2f50\u5982\"\u662f/\u5426\"),\u8fd9\u4e2a\u683c\u2f26\u5c31\u662f2\u2f8f2\u5217\u51714\u4e2a\u6570\u5b57\u7684\u2f45\u9635\u3002\n\n\u8fd9\u4e2a\u7ed3\u6784\u7684\u2f8f\u4ee3\u8868\u771f\u5b9e\u7684\u7c7b\u522b\u60c5\u51b5,\u5217\u4ee3\u8868\u6a21\u578b\u7684\u9884\u6d4b\u7ed3\u679c\u3002\u4ece\u5de6\u5230\u53f3\u3001\u4ece\u4e0a\u5230\u4e0b\u770b:\u7b2c\u2f00\u4e2a \u6570\u5b57\u662f\u6a21\u578b\u6b63\u786e\u8bc6\u522b\u4e3a\"\u662f\"\u7684\u6570\u91cf(\u771f\u6b63\u4f8b),\u7b2c\u2f06\u4e2a\u6570\u5b57\u662f\u6a21\u578b\u9519\u8bef\u5224\u65ad\u4e3a\"\u5426\"\u7684\u6570\u91cf(\u5047 \u8d1f\u4f8b),\u7b2c\u4e09\u4e2a\u6570\u5b57\u662f\u6a21\u578b\u9519\u8bef\u5224\u65ad\u4e3a\"\u662f\"\u7684\u6570\u91cf(\u5047\u6b63\u4f8b),\u7b2c\u56db\u4e2a\u6570\u5b57\u662f\u6a21\u578b\u6b63\u786e\u8bc6\u522b \u4e3a\"\u5426\"\u7684\u6570\u91cf(\u771f\u8d1f\u4f8b)\u3002\n\n\u5728\u591a\u5206\u7c7b\u95ee\u9898\u4e2d,\u8fd9\u4e2a\u7ed3\u6784\u4f1a\u6309\u7c7b\u522b\u6570\u91cf\u6269\u5c55\u3002\u2f50\u5982\u4e09\u7c7b\u95ee\u9898\u5c31\u662f3\u00d73\u7684\u683c\u2f26,\u5bf9\u2ec6\u7ebf\u4e0a\u7684\u6570 \u5b57\u8868\u793a\u5404\u7c7b\u522b\u88ab\u6b63\u786e\u5206\u7c7b\u7684\u6570\u91cf,\u5176\u4ed6\u4f4d\u7f6e\u5219\u8868\u793a\u88ab\u8bef\u5206\u7c7b\u5230\u5176\u4ed6\u7c7b\u522b\u7684\u6570\u91cf\u3002\u6bcf\u2f00\u2f8f\u6570\u5b57\u76f8 \u52a0\u5c31\u662f\u8be5\u7c7b\u522b\u7684\u5b9e\u9645\u603b\u6837\u672c\u6570,\u6bcf\u2f00\u5217\u6570\u5b57\u76f8\u52a0\u5219\u662f\u6a21\u578b\u9884\u6d4b\u4e3a\u8be5\u7c7b\u522b\u7684\u603b\u6b21\u6570\u3002\n\n\u5728\u591a\u5206\u7c7b\u95ee\u9898\u4e2d,\u8fd9\u4e2a\u7ed3\u6784\u4f1a\u6309\u7c7b\u522b\u6570\u91cf\u6269\u5c55\u3002\u2f50\u5982\u4e09\u7c7b\u95ee\u9898\u5c31\u662f3\u00d73\u7684\u683c\u2f26,\u5bf9\u2ec6\u7ebf\u4e0a\u7684\u6570 \u5b57\u8868\u793a\u5404\u7c7b\u522b\u88ab\u6b63\u786e\u5206\u7c7b\u7684\u6570\u91cf,\u5176\u4ed6\u4f4d\u7f6e\u5219\u8868\u793a\u88ab\u8bef\u5206\u7c7b\u5230\u5176\u4ed6\u7c7b\u522b\u7684\u6570\u91cf\u3002\u6bcf\u2f00\u2f8f\u6570\u5b57\u76f8 \u52a0\u5c31\u662f\u8be5\u7c7b\u522b\u7684\u5b9e\u9645\u603b\u6837\u672c\u6570,\u6bcf\u2f00\u5217\u6570\u5b57\u76f8\u52a0\u5219\u662f\u6a21\u578b\u9884\u6d4b\u4e3a\u8be5\u7c7b\u522b\u7684\u603b\u6b21\u6570\u3002\n\n### 3. \u5982\u4f55\u89e3\u8bfb\u6df7\u6dc6\u77e9\u9635?\n\n\u2fb8\u5148\u8981\u5173\u6ce8\u5bf9\u2ec6\u7ebf\u5143\u7d20,\u8fd9\u4e9b\u6570\u5b57\u4ee3\u8868\u6a21\u578b\u6b63\u786e\u9884\u6d4b\u7684\u6837\u672c\u6570\u91cf\u2014\u2014\u5bf9\u2ec6\u7ebf\u4e0a\u7684\u503c\u8d8a\u2fbc,\u8bf4\u660e \u6a21\u578b\u5728\u8be5\u7c7b\u522b\u4e0a\u7684\u51c6\u786e\u6027\u8d8a\u597d\u3002\u4f8b\u5982,\u5728\u2f06\u5206\u7c7b\u95ee\u9898\u4e2d,\u5de6\u4e0a\u2ec6\u7684\u771f\u6b63\u4f8b(TP)\u8868\u793a\u6a21\u578b\u6b63 \u786e\u8bc6\u522b\u51fa\u7684\u6b63\u7c7b\u6837\u672c,\u53f3\u4e0b\u2ec6\u7684\u771f\u8d1f\u4f8b(TN)\u8868\u793a\u6b63\u786e\u8bc6\u522b\u7684\u8d1f\u7c7b\u6837\u672c,\u8fd9\u4e24\u4e2a\u6570\u503c\u8d8a\u2f24, \u6a21\u578b\u7684\u6574\u4f53\u8868\u73b0\u8d8a\u597d\u3002\n\n\u7136\u2f7d,\u4ec5\u4ec5\u770b\u5bf9\u2ec6\u7ebf\u662f\u4e0d\u591f\u7684,\u6211\u4eec\u8fd8\u9700\u8981\u5206\u6790**\u2fae\u5bf9\u2ec6\u7ebf\u5143\u7d20**,\u56e0\u4e3a\u5b83\u4eec\u63ed\u793a\u4e86\u6a21\u578b\u7684\u9519\u8bef\u6a21 \u5f0f\u3002\u4f8b\u5982,**\u5047\u6b63\u4f8b(FP)**\u8868\u793a\u6a21\u578b\u5c06\u8d1f\u7c7b\u8bef\u5224\u4e3a\u6b63\u7c7b\u7684\u6570\u91cf,\u2f7d**\u5047\u8d1f\u4f8b(FN)**\u8868\u793a\u6a21\u578b\u6f0f\u5224 \u7684\u6b63\u7c7b\u6837\u672c\u3002\u5982\u679cFP\u8f83\u2fbc,\u8bf4\u660e\u6a21\u578b\u5b58\u5728\u8fc7\u5ea6\u9884\u6d4b\u6b63\u7c7b\u7684\u503e\u5411;\u5982\u679cFN\u8f83\u2fbc,\u5219\u53ef\u80fd\u610f\u5473\u7740 \u6a21\u578b\u8fc7\u4e8e\u4fdd\u5b88,\u6f0f\u6389\u4e86\u8bb8\u591a\u5b9e\u9645\u7684\u6b63\u7c7b\u6837\u672c\u3002", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 953, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "56d89ce7-2f5f-4f40-aa6d-ce9df7020500": {"__data__": {"id_": "56d89ce7-2f5f-4f40-aa6d-ce9df7020500", "embedding": null, "metadata": {"filename": "example_for_shap_0707.md", "extension": ".md"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "686622b5-2a39-4e53-b66a-0b657343c5ec", "node_type": "4", "metadata": {"filename": "example_for_shap_0707.md", "extension": ".md"}, "hash": "e4ff5a381b1ddaf9938e7c41d6432c2b90df298e7ccc742dde9d47453ae4a7fc", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "aa21ef16-2088-4dc1-9496-4865aa93142c", "node_type": "1", "metadata": {"filename": "example_for_shap_0707.md", "extension": ".md"}, "hash": "d53e674a3982cde533a5c0575005a94756fed41f5e4c99490a6f28490828e8bb", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "e1d282fc-effa-435b-be90-3054a888dd58", "node_type": "1", "metadata": {}, "hash": "8afc10c312b03bdc3a91742229678d0e0e7b1390ed99a57edcc96373e444aae6", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "\u7136\u2f7d,\u4ec5\u4ec5\u770b\u5bf9\u2ec6\u7ebf\u662f\u4e0d\u591f\u7684,\u6211\u4eec\u8fd8\u9700\u8981\u5206\u6790**\u2fae\u5bf9\u2ec6\u7ebf\u5143\u7d20**,\u56e0\u4e3a\u5b83\u4eec\u63ed\u793a\u4e86\u6a21\u578b\u7684\u9519\u8bef\u6a21 \u5f0f\u3002\u4f8b\u5982,**\u5047\u6b63\u4f8b(FP)**\u8868\u793a\u6a21\u578b\u5c06\u8d1f\u7c7b\u8bef\u5224\u4e3a\u6b63\u7c7b\u7684\u6570\u91cf,\u2f7d**\u5047\u8d1f\u4f8b(FN)**\u8868\u793a\u6a21\u578b\u6f0f\u5224 \u7684\u6b63\u7c7b\u6837\u672c\u3002\u5982\u679cFP\u8f83\u2fbc,\u8bf4\u660e\u6a21\u578b\u5b58\u5728\u8fc7\u5ea6\u9884\u6d4b\u6b63\u7c7b\u7684\u503e\u5411;\u5982\u679cFN\u8f83\u2fbc,\u5219\u53ef\u80fd\u610f\u5473\u7740 \u6a21\u578b\u8fc7\u4e8e\u4fdd\u5b88,\u6f0f\u6389\u4e86\u8bb8\u591a\u5b9e\u9645\u7684\u6b63\u7c7b\u6837\u672c\u3002\n\n\u5728\u591a\u5206\u7c7b\u95ee\u9898\u4e2d,\u6df7\u6dc6\u77e9\u9635\u7684\u89e3\u8bfb\u66f4\u52a0\u7ec6\u81f4\u3002\u6211\u4eec\u53ef\u4ee5\u89c2\u5bdf\u54ea\u4e9b\u7c7b\u522b\u5bb9\u6613\u88ab\u6df7\u6dc6,\u2f50\u5982\u7c7b\u522bA \u7684\u6837\u672c\u662f\u5426\u7ecf\u5e38\u88ab\u8bef\u5224\u4e3a\u7c7b\u522bB,\u8fd9\u53ef\u80fd\u610f\u5473\u7740\u8fd9\u4e24\u4e2a\u7c7b\u522b\u5728\u7279\u5f81\u4e0a\u8f83\u4e3a\u76f8\u4f3c,\u9700\u8981\u8fdb\u2f00\u6b65\u4f18 \u5316\u6a21\u578b\u6216\u8c03\u6574\u7279\u5f81\u2f2f\u7a0b\u3002\n\n# **Shap \u56fe**\n\n# 1. \u4ec0\u4e48\u662fshap\u503c?\n\nSHAP(SHapley Additive exPlanations)\u662f\u2f00\u79cd\u57fa\u4e8e\u535a\u5f08\u8bba\u7684\u89e3\u91ca\u2f45\u6cd5,\u2f64\u4e8e\u89e3\u91ca\u673a\u5668\u5b66\u4e60 \u6a21\u578b\u7684\u9884\u6d4b\u7ed3\u679c\u3002\u5b83\u7684\u6838\u2f3c\u601d\u60f3\u6765\u6e90\u4e8e\u535a\u5f08\u8bba\u7684Shapley\u503c,\u901a\u8fc7\u8ba1\u7b97\u6bcf\u4e2a\u7279\u5f81\u5bf9\u6a21\u578b\u9884\u6d4b\u7684 \u8d21\u732e\u5ea6,\u5e2e\u52a9\u7406\u89e3\u6a21\u578b\u7684\u51b3\u7b56\u8fc7\u7a0b\u3002\n\n- **\u53ef\u89e3\u91ca\u6027\u5f3a**:SHAP\u503c\u80fd\u660e\u786e\u91cf\u5316\u6bcf\u4e2a\u7279\u5f81\u5bf9\u5355\u4e2a\u9884\u6d4b\u7684\u5f71\u54cd\u3002\n- **\u2f00\u81f4\u6027**:\u5982\u679c\u67d0\u4e2a\u7279\u5f81\u5bf9\u6a21\u578b\u7684\u5f71\u54cd\u589e\u2f24,\u5176SHAP\u503c\u4e5f\u4f1a\u76f8\u5e94\u589e\u52a0\u3002\n- **\u5168\u5c40 & \u5c40\u90e8\u89e3\u91ca**:\u65e2\u53ef\u4ee5\u5206\u6790\u5355\u4e2a\u9884\u6d4b(\u5c40\u90e8\u89e3\u91ca),\u4e5f\u53ef\u4ee5\u603b\u7ed3\u6574\u4e2a\u6a21\u578b\u7684\u89c4\u5f8b(\u5168 \u5c40\u89e3\u91ca)\u3002\n\n## 2. \u5982\u4f55\u89e3\u8bfbshap\u56fe?\n\n\u7eb5\u8f74\u7684\u7279\u5f81\u6392\u5e8f\u4e0d\u662f\u57fa\u4e8e\u4f20\u7edf\u7684\u7279\u5f81\u91cd\u8981\u6027\u8ba1\u7b97\u2f45\u6cd5(\u5982Gini\u91cd\u8981\u6027\u6216Permutation Importance),\u2f7d\u662f\u6839\u636e\u6bcf\u4e2a\u7279\u5f81SHAP\u7edd\u5bf9\u503c\u7684\u5747\u503c\u964d\u5e8f\u6392\u5217\u3002\n\n- **\u9884\u6d4b\u2f00\u81f4\u6027**:\u76f4\u63a5\u53cd\u6620\u7279\u5f81\u5bf9\u6a21\u578b\u8f93\u51fa\u7684\u5b9e\u9645\u5f71\u54cd\u5f3a\u5ea6,\u907f\u514d\u4e86\u4f20\u7edf\u2f45\u6cd5\u53ef\u80fd\u4ea7\u2f63\u7684\u504f\u5dee\n- **\u2f45\u5411\u654f\u611f\u6027**:\u540c\u65f6\u8003\u8651\u6b63\u5411\u548c\u8d1f\u5411\u5f71\u54cd\u7684\u7edd\u5bf9\u503c,\u2f50\u4ec5\u8003\u8651\u5206\u88c2\u91cd\u8981\u6027\u7684\u2f45\u6cd5\u66f4\u5168\u2faf\n- **\u6837\u672c\u52a0\u6743**:\u6bcf\u4e2a\u6837\u672c\u7684\u8d21\u732e\u90fd\u88ab\u7eb3\u2f0a\u8ba1\u7b97,\u5bf9\u5f02\u5e38\u503c\u66f4\u7a33\u5065\n\n\u6a2a\u8f74\u7684SHAP\u503c\u8303\u56f4\u63ed\u793a\u4e86\u7279\u5f81\u5f71\u54cd\u7684\u5f3a\u5ea6\u548c\u2f45\u5411:\n\n- **\u6570\u503c\u8de8\u5ea6**:\u8303\u56f4\u8d8a\u5bbd\u8bf4\u660e\u8be5\u7279\u5f81\u5bf9\u9884\u6d4b\u7684\u5f71\u54cd\u5e45\u5ea6\u8d8a\u2f24\n- **\u96f6\u503c\u4f4d\u7f6e**:\u5982\u679c\u5206\u5e03\u4e2d\u2f3c\u504f\u79bb\u96f6\u503c,\u8868\u660e\u8be5\u7279\u5f81\u5b58\u5728\u7cfb\u7edf\u6027\u504f\u5dee\n- **\u6781\u7aef\u503c**:\u8fdc\u79bb\u4e3b\u4f53\u7684\u79bb\u6563\u70b9\u53ef\u80fd\u4ee3\u8868\u7279\u6b8a\u4e1a\u52a1\u573a\u666f\u6216\u6570\u636e\u8d28\u91cf\u95ee\u9898\n\n\u989c\u2f8a\u68af\u5ea6(\u901a\u5e38\u7ea2\u2f8a\u8868\u793a\u2fbc\u503c,\u84dd\u2f8a\u8868\u793a\u4f4e\u503c)\u63ed\u793a\u4e86\u7279\u5f81\u53d6\u503c\u4e0eSHAP\u503c\u4e4b\u95f4\u7684\u4ea4\u4e92\u6a21\u5f0f:\n\n\u5728SHAP\u56fe\u4e2d,\u6570\u636e\u70b9\u7684\u989c\u2f8a\u901a\u5e38\u4ee3\u8868\u7279\u5f81\u503c\u7684\u2f24\u2f29", "mimetype": "text/plain", "start_char_idx": 793, "end_char_idx": 1753, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "e1d282fc-effa-435b-be90-3054a888dd58": {"__data__": {"id_": "e1d282fc-effa-435b-be90-3054a888dd58", "embedding": null, "metadata": {"filename": "example_for_shap_0707.md", "extension": ".md"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "686622b5-2a39-4e53-b66a-0b657343c5ec", "node_type": "4", "metadata": {"filename": "example_for_shap_0707.md", "extension": ".md"}, "hash": "e4ff5a381b1ddaf9938e7c41d6432c2b90df298e7ccc742dde9d47453ae4a7fc", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "56d89ce7-2f5f-4f40-aa6d-ce9df7020500", "node_type": "1", "metadata": {"filename": "example_for_shap_0707.md", "extension": ".md"}, "hash": "806ea766736109e2124530638179a1e76f4231e36a10bbea556f976329e01c0b", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "6be6f743-67d1-402d-b8e3-e814a736f241", "node_type": "1", "metadata": {}, "hash": "697168b7074b9022023daefd7d98585129d782e977e75e7a5022f04216a11a30", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "\u6a2a\u8f74\u7684SHAP\u503c\u8303\u56f4\u63ed\u793a\u4e86\u7279\u5f81\u5f71\u54cd\u7684\u5f3a\u5ea6\u548c\u2f45\u5411:\n\n- **\u6570\u503c\u8de8\u5ea6**:\u8303\u56f4\u8d8a\u5bbd\u8bf4\u660e\u8be5\u7279\u5f81\u5bf9\u9884\u6d4b\u7684\u5f71\u54cd\u5e45\u5ea6\u8d8a\u2f24\n- **\u96f6\u503c\u4f4d\u7f6e**:\u5982\u679c\u5206\u5e03\u4e2d\u2f3c\u504f\u79bb\u96f6\u503c,\u8868\u660e\u8be5\u7279\u5f81\u5b58\u5728\u7cfb\u7edf\u6027\u504f\u5dee\n- **\u6781\u7aef\u503c**:\u8fdc\u79bb\u4e3b\u4f53\u7684\u79bb\u6563\u70b9\u53ef\u80fd\u4ee3\u8868\u7279\u6b8a\u4e1a\u52a1\u573a\u666f\u6216\u6570\u636e\u8d28\u91cf\u95ee\u9898\n\n\u989c\u2f8a\u68af\u5ea6(\u901a\u5e38\u7ea2\u2f8a\u8868\u793a\u2fbc\u503c,\u84dd\u2f8a\u8868\u793a\u4f4e\u503c)\u63ed\u793a\u4e86\u7279\u5f81\u53d6\u503c\u4e0eSHAP\u503c\u4e4b\u95f4\u7684\u4ea4\u4e92\u6a21\u5f0f:\n\n\u5728SHAP\u56fe\u4e2d,\u6570\u636e\u70b9\u7684\u989c\u2f8a\u901a\u5e38\u4ee3\u8868\u7279\u5f81\u503c\u7684\u2f24\u2f29\n\n- **\u989c\u2f8a\u7f16\u7801\u89c4\u5219**:\u5f53\u2f8a\u8c31\u91c7\u2f64\u8fde\u7eed\u6e10\u53d8\u65f6(\u7ea2\u2192\u7d2b\u2192\u84dd),\u7d2b\u2f8a\u901a\u5e38\u4ee3\u8868:\n  - **\u7ea2\u2f8a**:\u7279\u5f81\u503c\u6700\u2fbc(\u5982\u5e74\u9f84>75\u5c81)\n  - **\u7d2b\u2f8a**:\u7279\u5f81\u503c\u4e2d\u7b49(\u5982\u5e74\u9f8445-60\u5c81)\n  - **\u84dd\u2f8a**:\u7279\u5f81\u503c\u6700\u4f4e(\u5982\u5e74\u9f84<30\u5c81)\n- 1. \u5f53\u67d0\u4e2a\u7279\u5f81\u7684\u70b9\u4e91\u5448\u73b0\u6e05\u6670\u7684\"\u5de6\u84dd\u53f3\u7ea2\"\u6e10\u53d8\u6a21\u5f0f\u65f6,\u8868\u660e\u8be5\u7279\u5f81\u4e0e\u9884\u6d4b\u7ed3\u679c\u5b58\u5728\u5355\u8c03\u9012 \u589e\u5173\u7cfb,\u5373\u7279\u5f81\u503c\u8d8a\u2f24,\u5bf9\u9884\u6d4b\u7ed3\u679c\u7684\u6b63\u5411\u5f71\u54cd\u8d8a\u5f3a\n- 2. \u82e5\u5448\u73b0\"\u5de6\u7ea2\u53f3\u84dd\"\u5219\u663e\u793a\u5355\u8c03\u9012\u51cf\u5173\u7cfb\n- 3. U\u578b\u5206\u5e03\u4e2d\u4e24\u7aef\u663e\u793a\u7ea2\u2f8a\u2f7d\u4e2d\u95f4\u5448\u73b0\u84dd\u2f8a,\u6697\u793a\u8be5\u7279\u5f81\u5b58\u5728\u6700\u4f18\u533a\u95f4\u6548\u5e94\u2014\u2014\u8fc7\u2fbc\u6216\u8fc7\u4f4e \u7684\u53d6\u503c\u90fd\u4f1a\u4ea7\u2f63\u76f8\u4f3c\u7684\u5f71\u54cd\u2f45\u5411\u3002\u5178\u578b\u573a\u666f\u5982\u5e74\u9f84\u5bf9\u67d0\u4e9b\u75be\u75c5\u2edb\u9669\u7684\u5f71\u54cd,\u2ed8\u5c11\u5e74\u548c\u2f7c\u5e74 \u2f08\u7fa4(\u7ea2\u2f8a)\u2edb\u9669\u8f83\u2fbc,\u4e2d\u5e74\u7fa4\u4f53(\u84dd\u2f8a)\u2edb\u9669\u8f83\u4f4e\u3002\n- 4. \u5f53\u989c\u2f8a\u5f62\u6210\u591a\u4e2a\u5bc6\u5ea6\u4e2d\u2f3c\u65f6,\u53cd\u6620\u6570\u636e\u5b58\u5728\u6f5c\u5728\u2f26\u7fa4\u4f53\u3002\u4f8b\u5982\u5728\u7cd6\u5c3f\u75c5\u9884\u6d4b\u6a21\u578b\u4e2d,\u9910\u540e \u2f8e\u7cd6\u6ce2\u52a8\u7279\u5f81\u5e38\u5448\u73b0\u4e09\u7c07\u5206\u5e03:\u5de6\u4fa7\u6df1\u84dd\u2f8a\u96c6\u7fa4(\u2f8e\u7cd6\u6ce2\u52a8<1.5mmol/L)\u5bf9\u5e94\u5065\u5eb7\u2f08\u7fa4 \u7684\u6b63\u5e38\u80f0\u5c9b\u7d20\u54cd\u5e94\u6a21\u5f0f,\u5176SHAP\u503c\u663e\u8457\u4e3a\u8d1f(\u7ea6-0.8),\u8868\u660e\u7a33\u5b9a\u2f8e\u7cd6\u662f\u91cd\u8981\u7684\u4fdd\u62a4\u6027 \u56e0\u7d20;\u4e2d\u95f4\u7d2b\u2f8a\u96c6\u7fa4(1.5-3.0mmol/L)\u53cd\u6620\u7cd6\u8010\u91cf\u53d7\u635f\u72b6\u6001,SHAP\u503c\u4e2d\u6027,\u63d0\u793a\u8be5\u533a \u95f4\u53ef\u80fd\u5904\u4e8e\u4ee3\u507f\u671f\u8fc7\u6e21\u9636\u6bb5;\u53f3\u4fa7\u7ea2\u2f8a\u96c6\u7fa4(>3.0mmol/L)\u5219\u663e\u793a\u03b2\u7ec6\u80de\u529f\u80fd\u969c\u788d\u7684\u7cd6\u5c3f \u75c5\u524d\u671f\u7279\u5f81,SHAP\u503c\u2fbc\u8fbe+1.2,\u5f3a\u70c8\u9884\u8b66\u75be\u75c5\u2edb\u9669\u3002\n- 5. \u82e5\u7ea2\u84dd\u6df7\u6742\u5728\u4e2d\u95f4 \u2192 \u8868\u793a\u8be5\u7279\u5f81\u5bf9\u4e0d\u540c\u6837\u672c\u4f5c\u2f64\u2f45\u5411\u4e0d\u2f00\u81f4(\u5b58\u5728\u2fae\u7ebf\u6027\u6216\u4ea4\u4e92)\n\n## \u793a\u4f8b\u89e3\u8bfb\n\n#### \u7279\u5f81\u89e3\u6790", "mimetype": "text/plain", "start_char_idx": 1556, "end_char_idx": 2393, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "6be6f743-67d1-402d-b8e3-e814a736f241": {"__data__": {"id_": "6be6f743-67d1-402d-b8e3-e814a736f241", "embedding": null, "metadata": {"filename": "example_for_shap_0707.md", "extension": ".md"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "686622b5-2a39-4e53-b66a-0b657343c5ec", "node_type": "4", "metadata": {"filename": "example_for_shap_0707.md", "extension": ".md"}, "hash": "e4ff5a381b1ddaf9938e7c41d6432c2b90df298e7ccc742dde9d47453ae4a7fc", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "e1d282fc-effa-435b-be90-3054a888dd58", "node_type": "1", "metadata": {"filename": "example_for_shap_0707.md", "extension": ".md"}, "hash": "e3d2ab60f3785bde11b1e7c793e5279edc99548cfafac518d91e7e96d72dd1d7", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "1bba08a8-c770-46cd-8c5e-09bfbf485abb", "node_type": "1", "metadata": {}, "hash": "3839f0a00f369cb1c8818198e8578b8656f43494f9a93bf685cfd0725bf7e9c3", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## \u793a\u4f8b\u89e3\u8bfb\n\n#### \u7279\u5f81\u89e3\u6790\n\n- 1. NTPROBNP **(N\u672b\u7aefB\u578b\u5229\u94a0\u80bd\u524d\u4f53)**\n  - \u5206\u5e03\u5f62\u6001: \u7ea2\u2f8a\u2fbc\u503c\u70b9\u96c6\u4e2d\u5728shap\u6b63\u503c(0.5 1.5)\n  - NTPROBNP\u2f54\u5e73\u5347\u2fbc(\u7ea2\u70b9)\u4e0e\u75be\u75c5\u2edb\u9669(\u2f3c\u8870)\u6b63\u76f8\u5173,\u7b26\u5408BNP\u4f5c\u4e3a\u2f3c\u8870\u6807\u5fd7 \u7269\u7684\u533b\u5b66\u5171\u8bc6\n  - \u4f4e\u503c\u6837\u672c(\u84dd\u70b9)\u7684SHAP\u503c\u63a5\u8fd1\u96f6,\u8bf4\u660e\u6b63\u5e38\u8303\u56f4\u5185\u6ce2\u52a8\u5f71\u54cd\u2f29, \u60a3\u8005\u7684\u2f3c\u8870\u2edb\u9669\u8f83 \u4f4e\n- 2. AGE (\u5e74\u9f84)\n  - \u5206\u5e03\u5f62\u6001:\u7ea2\u2f8a\u70b9(\u2fbc\u9f84)\u96c6\u4e2d\u5728\u53f3\u4fa7(SHAP>0), \u84dd\u2f8a\u70b9(\u4f4e\u9f84)\u5728\u5de6\u4fa7(SHAP<0)\n  - \u5e74\u9f84\u8d8a\u2f24,\u5bf9\u9884\u6d4b\u7ed3\u679c\u7684\u6b63\u5411\u8d21\u732e\u8d8a\u2f24,\u60a3\u8005\u7684\u2f3c\u8870\u2edb\u9669\u8f83\u2fbc,\u5e74\u9f84\u662f\u75be\u75c5\u2edb\u9669\u56e0\u7d20\n- 3. EF (\u5c04\u2f8e\u5206\u6570)\n  - \u5206\u5e03\u5f62\u6001:\u84dd\u2f8a\u70b9(\u4f4eEF\u503c)\u5728\u53f3\u4fa7(SHAP > 0), \u7ea2\u2f8a\u70b9(\u2fbcEF\u503c)\u5728\u5de6\u4fa7(SHAP < 0)\n  - EF\u8d8a\u4f4e,\u60a3\u8005\u7684\u2f3c\u810f\u529f\u80fd\u8d8a\u5dee,\u2f3c\u8870\u2edb\u9669\u589e\u2fbc,\u5bf9\u6a21\u578b\u8f93\u51fa\u7684\u6b63\u5411\u5f71\u54cd\u8d8a\u5f3a\n\n- 4. CR (\u808c\u9150)\n  - \u5206\u5e03\u5f62\u6001: \u7ea2\u2f8a\u70b9\u96c6\u4e2d\u5728Shap \u6b63\u503c,\u84dd\u2f8a\u70b9\u96c6\u4e2d\u5728Shap\u8d1f\u503c,\u9760\u8fd10\u7684\u8d1f\u503c\u533a\u57df\u51fa \u73b0\u6df7\u5408\u989c\u2f8a\n  - \u2fbc\u808c\u9150\u2f54\u5e73\u663e\u8457\u589e\u52a0\u2f3c\u8870\u6076\u5316\u2edb\u9669,\u6bcf\u589e\u52a01mg/dL\u808c\u9150,\u2f3c\u8870\u2edb\u9669\u663e\u8457\u4e0a\u5347\n  - \u4f4e\u808c\u9150\u53ef\u80fd\u53cd\u6620\u771f\u6b63\u80be\u529f\u80fd\u8d85\u5e38\u7684\u5065\u5eb7\u72b6\u6001\n  - \u5f69\u2f8a\u6df7\u6742\u8868\u660e\u808c\u9150\u7684\"\u6b63\u5e38\u8303\u56f4\"\u5bf9\u9884\u6d4b\u7684\u5f71\u54cd\u590d\u6742:\u67d0\u4e9b\"\u6b63\u5e38\u504f\u2fbc\"\u808c\u9150(\u7ea2\u70b9)\u4ecd \u663e\u793a\u5fae\u5f31\u2edb\u9669\u589e\u52a0,\u7d2b\u2f8a\u70b9\u53ef\u80fd\u5bf9\u5e94\u808c\u9150\u8f7b\u5ea6\u5347\u2fbc\u4f46\u5176\u4ed6\u6307\u6807\u8865\u507f\u7684\u60a3\u8005\n- 5. RA1 (\u53f3\u2f3c\u623f)\n  - \u5206\u5e03\u5f62\u6001:\u7ea2\u2f8a\u70b9\u96c6\u4e2d\u5728\u9760\u8fd10\u7684\u6b63\u503c\u533a\u57df,\u84dd\u2f8a\u70b9\u96c6\u4e2d\u5728\u5de6\u4fa7\u8d1f\u503c\u533a\u57df\n  - \u2fbcRA1\u503c(\u7ea2\u2f8a)\u4ea7\u2f63\u5fae\u5f31\u6b63\u5411\u5f71\u54cd,\u4f46\u5f71\u54cd\u7a0b\u5ea6\u6709\u9650,\u6240\u4ee5\u53f3\u2f3c\u623f\u589e\u2f24\u786e\u5b9e\u4e0e\u2edb\u9669 \u589e\u52a0\u76f8\u5173,\u4f46\u662f\u5355\u72ecRA1\u589e\u2f24\u4e0d\u662f\u5f3a\u9884\u6d4b\u56e0\u2f26\n  - \u5065\u5eb7\u2f08\u7fa4\u7684\u6b63\u5e38\u53f3\u2f3c\u623f\u5c3a\u2f28,\u2f3c\u8870\u2edb\u9669\u4f4e\n- 6. WEIGHT (\u4f53\u91cd)\n  - \u5206\u5e03\u5f62\u6001:\u84dd\u2f8a\u70b9(\u4f53\u91cd\u8f7b)\u96c6\u4e2d\u5728\u53f3\u4fa7(SHAP>0), \u7ea2\u2f8a\u70b9(\u2fbc\u4f53\u91cd)\u5728\u5de6\u4fa7 (SHAP<0)\n  - \u2f3c\u8870\u5bfc\u81f4\u7684\u6d88\u8017\u6027\u4f53\u91cd\u4e0b\u964d(\u75be\u75c5\u4e25\u91cd\u5ea6\u7684\u6807\u5fd7)\n  - \u80a5\u80d6\u672c\u8eab\u5bf9\u9884\u6d4b\u7684\u8d21\u732e\u76f8\u5bf9\u8f83\u2f29,\u4e0d\u4f1a\u76f4\u63a5\u5bfc\u81f4\u2f3c\u8870\n\n## **Learning Curve \u5b66\u4e60\u66f2\u7ebf**\n\n### 1. \u4ec0\u4e48\u662f\u5b66\u4e60\u66f2\u7ebf?", "mimetype": "text/plain", "start_char_idx": 2375, "end_char_idx": 3293, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "1bba08a8-c770-46cd-8c5e-09bfbf485abb": {"__data__": {"id_": "1bba08a8-c770-46cd-8c5e-09bfbf485abb", "embedding": null, "metadata": {"filename": "example_for_shap_0707.md", "extension": ".md"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "686622b5-2a39-4e53-b66a-0b657343c5ec", "node_type": "4", "metadata": {"filename": "example_for_shap_0707.md", "extension": ".md"}, "hash": "e4ff5a381b1ddaf9938e7c41d6432c2b90df298e7ccc742dde9d47453ae4a7fc", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "6be6f743-67d1-402d-b8e3-e814a736f241", "node_type": "1", "metadata": {"filename": "example_for_shap_0707.md", "extension": ".md"}, "hash": "b82646208ae3f04c27fc5d881ed1d2c5e2f419defd457ecee03ddb56e5b2e38f", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "9d56ec5b-8ee2-46e7-a6e6-ab3abab7ff3a", "node_type": "1", "metadata": {}, "hash": "83798efcbf01663be4b73236575117c52a150882650d9105062929bb35fcc8fc", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "## **Learning Curve \u5b66\u4e60\u66f2\u7ebf**\n\n### 1. \u4ec0\u4e48\u662f\u5b66\u4e60\u66f2\u7ebf?\n\n\u5b66\u4e60\u66f2\u7ebf\u662f\u673a\u5668\u5b66\u4e60\u4e2d\u2f64\u4e8e\u8bc4\u4f30\u6a21\u578b\u6027\u80fd\u968f\u8bad\u7ec3\u6570\u636e\u91cf\u6216\u8bad\u7ec3\u8fed\u4ee3\u6b21\u6570\u53d8\u5316\u7684\u91cd\u8981\u5206\u6790\u2f2f\u5177, \u5b83\u901a\u8fc7\u53ef\u89c6\u5316\u5f62\u5f0f\u63ed\u793a\u6a21\u578b\u7684\u5b66\u4e60\u52a8\u6001\u548c\u6f5c\u5728\u95ee\u9898\u3002\u5b66\u4e60\u66f2\u7ebf\u7684\u6838\u2f3c\u4ef7\u503c\u5728\u4e8e\u5e2e\u52a9\u5f00\u53d1\u8005\u7406\u89e3 \u4e09\u7ec4\u5173\u952e\u5173\u7cfb:\u6a21\u578b\u5bb9\u91cf\u4e0e\u6570\u636e\u91cf\u7684\u5339\u914d\u7a0b\u5ea6\u3001\u8bad\u7ec3\u8fc7\u7a0b\u4e2d\u7684\u4f18\u5316\u72b6\u6001,\u4ee5\u53ca\u6a21\u578b\u6700\u7ec8\u7684\u6cdb\u5316 \u80fd\u2f12\u8fb9\u754c\u3002\u901a\u8fc7\u5206\u6790\u5b66\u4e60\u66f2\u7ebf\u7684\u5f62\u6001,\u53ef\u4ee5\u5224\u65ad\u6a21\u578b\u662f\u5426\u5b58\u5728**\u2f4b\u62df\u5408(Underfitting)**\u3001**\u8fc7\u62df \u5408(Overfitting)**,\u6216\u8005\u662f\u5426\u5df2\u8fbe\u5230\u6700\u4f18\u6027\u80fd\u3002\n\n#### 2. \u5b66\u4e60\u66f2\u7ebf\u7684\u7406\u8bba\u57fa\u7840\n\n\u5b66\u4e60\u66f2\u7ebf\u7684\u6570\u5b66\u672c\u8d28\u662f\u63cf\u8ff0\u7ecf\u9a8c\u2edb\u9669(\u8bad\u7ec3\u8bef\u5dee)\u548c\u7ed3\u6784\u2edb\u9669(\u6d4b\u8bd5\u8bef\u5dee)\u968f\u8bad\u7ec3\u89c4\u6a21\u53d8\u5316\u7684 \u51fd\u6570\u5173\u7cfb\u3002\u6839\u636e\u7edf\u8ba1\u5b66\u4e60\u7406\u8bba,\u5f53\u8bad\u7ec3\u6837\u672c\u6570m\u589e\u52a0\u65f6,\u8bad\u7ec3\u8bef\u5dee\u4f1a\u5355\u8c03\u9012\u589e\u5e76\u6536\u655b,\u2f7d\u6d4b\u8bd5 \u8bef\u5dee\u5355\u8c03\u9012\u51cf\u5e76\u6536\u655b,\u4e24\u8005\u6700\u7ec8\u8d8b\u4e8e\u903c\u8fd1\u3002Vapnik-Chervonenkis\u7ef4\u5ea6\u7406\u8bba\u6307\u51fa,\u6536\u655b\u901f\u5ea6\u4e0e \u6a21\u578b\u590d\u6742\u5ea6\u76f4\u63a5\u76f8\u5173:\u2fbc\u5bb9\u91cf\u6a21\u578b\u9700\u8981\u66f4\u591a\u6570\u636e\u624d\u80fd\u4f7f\u6d4b\u8bd5\u8bef\u5dee\u6536\u655b\u3002\n\n#### 3. \u5982\u4f55\u89e3\u8bfb\u5b66\u4e60\u66f2\u7ebf?\n\n\u5b66\u4e60\u66f2\u7ebf\u901a\u5e38\u6709\u4e24\u79cd\u5f62\u5f0f,\u53d6\u51b3\u4e8e\u6a2a\u8f74\u7684\u9009\u62e9:\n\n- \u6a2a\u8f74 = \u8bad\u7ec3\u6570\u636e\u91cf(\u6837\u672c\u6570)\n- **\u7eb5\u8f74 = \u6a21\u578b\u6027\u80fd\u6307\u6807**(\u5982\u51c6\u786e\u7387\u3001F1\u5206\u6570\u3001\u5747\u2f45\u8bef\u5dee\u7b49)\n- **\u9002\u2f64\u573a\u666f**:\u8bc4\u4f30**\u6570\u636e\u91cf\u5bf9\u6a21\u578b\u6027\u80fd\u7684\u5f71\u54cd**,\u5224\u65ad\u662f\u5426\u9700\u8981\u6536\u96c6\u66f4\u591a\u6570\u636e\u3002\n\n\u5b66\u4e60\u66f2\u7ebf\u901a\u5e38\u5305\u542b\u4e24\u6761\u7ebf:\n\n- **\u8bad\u7ec3\u96c6\u66f2\u7ebf(Training Score)**:\u6a21\u578b\u5728\u8bad\u7ec3\u6570\u636e\u4e0a\u7684\u8868\u73b0\u3002\n- **\u9a8c\u8bc1\u96c6\u66f2\u7ebf(Validation Score)**:\u6a21\u578b\u5728\u672a\u2ec5\u6570\u636e(\u9a8c\u8bc1\u96c6/\u6d4b\u8bd5\u96c6)\u4e0a\u7684\u8868\u73b0\u3002\n\n\u7406\u60f3\u7684\u5b66\u4e60\u66f2\u7ebf:\n\n- \u8bad\u7ec3\u96c6\u548c\u9a8c\u8bc1\u5bc4\u66f2\u7ebf\u9010\u6e10\u63a5\u8fd1,\u6700\u7ec8\u7a33\u5b9a\u5728\u2f00\u4e2a\u8f83\u2fbc\u997f\u7684\u6027\u80fd\u2f54\u5e73\u3002\n- **\u4e24\u6761\u66f2\u7ebf\u4e4b\u95f4\u7684\u5dee\u8ddd\u8f83\u2f29**,\u8bf4\u660e\u6a21\u578b\u6cdb\u5316\u80fd\u2f12\u5f3a,\u6ca1\u6709\u8fc7\u62df\u5408\u6216\u2f4b\u62df\u5408\u3002\n- \u4f8b\u5982:\u6a2a\u8f74:\u8bad\u7ec3\u6837\u672c\u6570\u589e\u52a0 \u2192 \u7eb5\u8f74:\u8bad\u7ec3\u51c6\u786e\u7387\u7f13\u6162\u4e0b\u964d,\u9a8c\u8bc1\u51c6\u786e\u7387\u4e0a\u5347,\u6700\u7ec8\u8d8b \u4e8e\u7a33\u5b9a\u3002\n\n\u2f4b\u62df\u5408 (underfitting) :\n\n- **\u8bad\u7ec3\u96c6\u548c\u9a8c\u8bc1\u96c6\u6027\u80fd\u90fd\u5f88\u4f4e**,\u4e14\u4e24\u6761\u66f2\u7ebf\u63a5\u8fd1\n- \u53ef\u80fd\u7684\u539f\u56e0:\n  - \u6a21\u578b\u592a\u7b80\u5355(\u5982\u7ebf\u6027\u6a21\u578b\u62df\u5408\u2fae\u7ebf\u6027\u6570\u636e)\u3002\n  - \u7279\u5f81\u2f2f\u7a0b\u4e0d\u2f9c(\u7f3a\u4e4f\u5173\u952e\u7279\u5f81)\u3002\n  - \u8bad\u7ec3\u6570\u636e\u4e0d\u2f9c(\u4f46\u5373\u4f7f\u589e\u52a0\u6570\u636e,\u6027\u80fd\u4ecd\u4e0d\u4f1a\u663e\u8457\u63d0\u5347)\n- \u89e3\u51b3\u2f45\u6848:", "mimetype": "text/plain", "start_char_idx": 3250, "end_char_idx": 4211, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "9d56ec5b-8ee2-46e7-a6e6-ab3abab7ff3a": {"__data__": {"id_": "9d56ec5b-8ee2-46e7-a6e6-ab3abab7ff3a", "embedding": null, "metadata": {"filename": "example_for_shap_0707.md", "extension": ".md"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "686622b5-2a39-4e53-b66a-0b657343c5ec", "node_type": "4", "metadata": {"filename": "example_for_shap_0707.md", "extension": ".md"}, "hash": "e4ff5a381b1ddaf9938e7c41d6432c2b90df298e7ccc742dde9d47453ae4a7fc", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "1bba08a8-c770-46cd-8c5e-09bfbf485abb", "node_type": "1", "metadata": {"filename": "example_for_shap_0707.md", "extension": ".md"}, "hash": "3251609d97bfdafac142860df7679a9ae4e1809a269bbe50c287bfbc692967f5", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "\u2f4b\u62df\u5408 (underfitting) :\n\n- **\u8bad\u7ec3\u96c6\u548c\u9a8c\u8bc1\u96c6\u6027\u80fd\u90fd\u5f88\u4f4e**,\u4e14\u4e24\u6761\u66f2\u7ebf\u63a5\u8fd1\n- \u53ef\u80fd\u7684\u539f\u56e0:\n  - \u6a21\u578b\u592a\u7b80\u5355(\u5982\u7ebf\u6027\u6a21\u578b\u62df\u5408\u2fae\u7ebf\u6027\u6570\u636e)\u3002\n  - \u7279\u5f81\u2f2f\u7a0b\u4e0d\u2f9c(\u7f3a\u4e4f\u5173\u952e\u7279\u5f81)\u3002\n  - \u8bad\u7ec3\u6570\u636e\u4e0d\u2f9c(\u4f46\u5373\u4f7f\u589e\u52a0\u6570\u636e,\u6027\u80fd\u4ecd\u4e0d\u4f1a\u663e\u8457\u63d0\u5347)\n- \u89e3\u51b3\u2f45\u6848:\n\n- \u4f7f\u2f64\u66f4\u590d\u6742\u7684\u6a21\u578b(\u5982\u4ece\u7ebf\u6027\u56de\u5f52\u5207\u6362\u5230\u51b3\u7b56\u6811\u6216\u795e\u7ecf\u2f79\u7edc)\u3002\n- \u589e\u52a0\u7279\u5f81(\u5982\u591a\u9879\u5f0f\u7279\u5f81\u3001\u4ea4\u4e92\u7279\u5f81)\u3002\n- \u51cf\u5c11\u6b63\u5219\u5316(\u5982\u964d\u4f4eL2\u6b63\u5219\u5316\u7cfb\u6570)\u3002\n\n\u8fc7\u62df\u5408(overfitting):\n\n- **\u8bad\u7ec3\u96c6\u6027\u80fd\u5f88\u2fbc,\u4f46\u9a8c\u8bc1\u96c6\u6027\u80fd\u8f83\u4f4e**,\u4e24\u6761\u66f2\u7ebf\u5dee\u8ddd\u2f24\u3002\n- \u53ef\u80fd\u539f\u56e0:\n  - \u6a21\u578b\u592a\u590d\u6742(\u5982\u6df1\u5ea6\u795e\u7ecf\u2f79\u7edc\u5728\u2f29\u6570\u636e\u96c6\u4e0a\u8bad\u7ec3)\u3002\n  - \u8bad\u7ec3\u6570\u636e\u4e0d\u2f9c(\u6a21\u578b\u8bb0\u4f4f\u4e86\u8bad\u7ec3\u6570\u636e,\u4f46\u2f46\u6cd5\u6cdb\u5316)\n- **\u89e3\u51b3\u2f45\u6848**:\n  - \u589e\u52a0\u8bad\u7ec3\u6570\u636e(\u6700\u6709\u6548\u7684\u2f45\u6cd5)\u3002\n  - \u4f7f\u2f64\u6b63\u5219\u5316(L1/L2\u6b63\u5219\u5316\u3001Dropout)\u3002\n  - \u964d\u4f4e\u6a21\u578b\u590d\u6742\u5ea6(\u5982\u51cf\u5c11\u795e\u7ecf\u2f79\u7edc\u7684\u5c42\u6570)\u3002\n  - \u65e9\u505c(Early Stopping)\u9632\u2f4c\u8fc7\u62df\u5408\u3002\n\n\u6570\u636e\u4e0d\u2f9c(\u6a21\u578b\u672a\u6536\u655b):\n\n- **\u8bad\u7ec3\u96c6\u548c\u9a8c\u8bc1\u96c6\u6027\u80fd\u4ecd\u5728\u4e0a\u5347**,\u672a\u8fbe\u5230\u7a33\u5b9a\u72b6\u6001\u3002\n- \u53ef\u80fd\u539f\u56e0:\n  - \u8bad\u7ec3\u6570\u636e\u592a\u5c11,\u6a21\u578b\u5c1a\u672a\u5b66\u5230\u2f9c\u591f\u6a21\u5f0f\u3002\n- \u89e3\u51b3\u2f45\u6848:\n  - \u6536\u96c6\u66f4\u591a\u6570\u636e", "mimetype": "text/plain", "start_char_idx": 4071, "end_char_idx": 4610, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}}, "docstore/metadata": {"aa21ef16-2088-4dc1-9496-4865aa93142c": {"doc_hash": "d53e674a3982cde533a5c0575005a94756fed41f5e4c99490a6f28490828e8bb", "ref_doc_id": "686622b5-2a39-4e53-b66a-0b657343c5ec"}, "56d89ce7-2f5f-4f40-aa6d-ce9df7020500": {"doc_hash": "806ea766736109e2124530638179a1e76f4231e36a10bbea556f976329e01c0b", "ref_doc_id": "686622b5-2a39-4e53-b66a-0b657343c5ec"}, "e1d282fc-effa-435b-be90-3054a888dd58": {"doc_hash": "e3d2ab60f3785bde11b1e7c793e5279edc99548cfafac518d91e7e96d72dd1d7", "ref_doc_id": "686622b5-2a39-4e53-b66a-0b657343c5ec"}, "6be6f743-67d1-402d-b8e3-e814a736f241": {"doc_hash": "b82646208ae3f04c27fc5d881ed1d2c5e2f419defd457ecee03ddb56e5b2e38f", "ref_doc_id": "686622b5-2a39-4e53-b66a-0b657343c5ec"}, "1bba08a8-c770-46cd-8c5e-09bfbf485abb": {"doc_hash": "3251609d97bfdafac142860df7679a9ae4e1809a269bbe50c287bfbc692967f5", "ref_doc_id": "686622b5-2a39-4e53-b66a-0b657343c5ec"}, "9d56ec5b-8ee2-46e7-a6e6-ab3abab7ff3a": {"doc_hash": "ffecc10cbbc7ce963067facf789b97b34e77637c7521189c2cc866ae5a94669a", "ref_doc_id": "686622b5-2a39-4e53-b66a-0b657343c5ec"}}}
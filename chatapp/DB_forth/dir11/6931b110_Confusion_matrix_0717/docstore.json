{"docstore/ref_doc_info": {"51a76f7e-f1df-4e02-9655-ecc883ebf6fc": {"node_ids": ["1260a542-355d-4d34-a165-88fb1d1560fc", "8bfa5e74-a906-428b-83b5-6b4b0992a286", "02adfdae-7d3b-4a04-bc34-7dfaa4f45e81", "85cecd54-ccee-4d01-9d7e-069bacc091ef", "62f62bcb-fe45-4b45-9512-8a637f085b2a", "6a653841-0e7f-4471-8b39-09ae0aba6652", "9c551fac-eaae-42d7-9d64-c473d133b9c3", "e9776421-05dc-46cd-8de4-5dddc98eaf4f", "9caf447a-c377-49ae-a7ec-d8f76856868a", "a5016720-3c16-43e7-934d-18d38cf7f8c7", "79b57d73-7ee8-4e09-a312-c6731f20ae64", "3743fede-e0af-465c-8255-6ba40e58462d"], "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}}}, "docstore/data": {"1260a542-355d-4d34-a165-88fb1d1560fc": {"__data__": {"id_": "1260a542-355d-4d34-a165-88fb1d1560fc", "embedding": null, "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc", "node_type": "4", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "6971639435ca4e8b816c79535888daf2db8497c96ffac8510fd86bb1384292f0", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "8bfa5e74-a906-428b-83b5-6b4b0992a286", "node_type": "1", "metadata": {}, "hash": "c0a4639827e371b46e4ba2fc50e0b4aac5b53e97a459d764915cd9d25b32ce9a", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "# **\u6df7\u6dc6\u77e9\u9635 (Confusion matrix)**\n\n## 1. \u4ec0\u4e48\u662f\u6df7\u6dc6\u77e9\u9635?\n\n\u6df7\u6dc6\u77e9\u9635(Confusion matrix)\u662f\u673a\u5668\u5b66\u4e60\u4e2d\u2f64\u4e8e\u8bc4\u4f30\u5206\u7c7b\u6a21\u578b\u6027\u80fd\u7684\u2f00\u79cd\u8868\u683c\u5e03\u5c40\u2f2f\u5177\u3002\u5b83\u4ee5 \u76f4\u89c2\u7684\u2f45\u5f0f\u5c55\u793a\u4e86\u6a21\u578b\u9884\u6d4b\u7ed3\u679c\u4e0e\u5b9e\u9645\u60c5\u51b5\u4e4b\u95f4\u7684\u5bf9\u5e94\u5173\u7cfb,\u7279\u522b\u9002\u2f64\u4e8e\u2f06\u5206\u7c7b\u95ee\u9898(\u4f46\u4e5f \u53ef\u6269\u5c55\u5230\u591a\u5206\u7c7b)\u3002\n\n### 2. \u6df7\u6dc6\u77e9\u9635\u7ed3\u6784\n\n\u60f3\u8c61\u5b83\u662f\u2f00\u4e2a\u6b63\u2f45\u5f62\u7684\u683c\u2f26,\u2f8f\u548c\u5217\u7684\u6570\u91cf\u53d6\u51b3\u4e8e\u5206\u7c7b\u95ee\u9898\u7684\u7c7b\u522b\u6570\u3002\u5bf9\u4e8e\u6700\u7b80\u5355\u7684\u2f06\u5206\u7c7b \u95ee\u9898(\u2f50\u5982\"\u662f/\u5426\"),\u8fd9\u4e2a\u683c\u2f26\u5c31\u662f2\u2f8f2\u5217\u51714\u4e2a\u6570\u5b57\u7684\u2f45\u9635\u3002\n\n\u5728\u2f06\u5206\u7c7b\u95ee\u9898\u4e2d,\u6df7\u6dc6\u77e9\u9635\u901a\u5e38\u88ab\u6784\u5efa\u4e3a\u2f00\u4e2a2\u00d72\u7684\u77e9\u9635,\u6a2a\u8f74\u8868\u793a\u6a21\u578b\u7684\u9884\u6d4b\u6807\u7b7e,\u7eb5\u8f74\u8868 \u793a\u6570\u636e\u7684\u771f\u5b9e\u6807\u7b7e,\u5176\u4e2d\u5305\u542b\u56db\u4e2a\u57fa\u672c\u5143\u7d20:\u771f\u6b63(True Positive, TP)\u3001\u5047\u6b63(False Positive, FP)\u3001\u771f\u8d1f(True Negative, TN)\u548c\u5047\u8d1f(False Negative, FN)\u3002\n\n\u5728\u591a\u5206\u7c7b\u95ee\u9898\u4e2d,\u8fd9\u4e2a\u7ed3\u6784\u4f1a\u6309\u7c7b\u522b\u6570\u91cf\u6269\u5c55\u3002\u2f50\u5982\u4e09\u7c7b\u95ee\u9898\u5c31\u662f3\u00d73\u7684\u683c\u2f26,\u5bf9\u2ec6\u7ebf\u4e0a\u7684\u6570 \u5b57\u8868\u793a\u5404\u7c7b\u522b\u88ab\u6b63\u786e\u5206\u7c7b\u7684\u6570\u91cf,\u5176\u4ed6\u4f4d\u7f6e\u5219\u8868\u793a\u88ab\u8bef\u5206\u7c7b\u5230\u5176\u4ed6\u7c7b\u522b\u7684\u6570\u91cf\u3002\u6bcf\u2f00\u2f8f\u6570\u5b57 \u76f8\u52a0\u5c31\u662f\u8be5\u7c7b\u522b\u7684\u5b9e\u9645\u603b\u6837\u672c\u6570,\u6bcf\u2f00\u5217\u6570\u5b57\u76f8\u52a0\u5219\u662f\u6a21\u578b\u9884\u6d4b\u4e3a\u8be5\u7c7b\u522b\u7684\u603b\u6b21\u6570\u3002\n\n#### 3. \u5982\u4f55\u89e3\u8bfb\u6df7\u6dc6\u77e9\u9635?\n\n\u2fb8\u5148\u8981\u5173\u6ce8\u5bf9\u2ec6\u7ebf\u5143\u7d20,\u8fd9\u4e9b\u6570\u5b57\u4ee3\u8868\u6a21\u578b\u6b63\u786e\u9884\u6d4b\u7684\u6837\u672c\u6570\u91cf\u2014\u2014\u5bf9\u2ec6\u7ebf\u4e0a\u7684\u503c\u8d8a\u2fbc,\u8bf4 \u660e\u6a21\u578b\u5728\u8be5\u7c7b\u522b\u4e0a\u7684\u51c6\u786e\u6027\u8d8a\u597d\u3002\u4f8b\u5982,\u5728\u2f06\u5206\u7c7b\u95ee\u9898\u4e2d,\u5de6\u4e0a\u2ec6\u7684\u771f\u6b63\u4f8b(TP)\u8868\u793a\u6a21\u578b \u6b63\u786e\u8bc6\u522b\u51fa\u7684\u6b63\u7c7b\u6837\u672c,\u53f3\u4e0b\u2ec6\u7684\u771f\u8d1f\u4f8b(TN)\u8868\u793a\u6b63\u786e\u8bc6\u522b\u7684\u8d1f\u7c7b\u6837\u672c,\u8fd9\u4e24\u4e2a\u6570\u503c\u8d8a \u2f24,\u6a21\u578b\u7684\u6574\u4f53\u8868\u73b0\u8d8a\u597d\u3002\n\n\u7136\u2f7d,\u4ec5\u4ec5\u770b\u5bf9\u2ec6\u7ebf\u662f\u4e0d\u591f\u7684,\u6211\u4eec\u8fd8\u9700\u8981\u5206\u6790**\u2fae\u5bf9\u2ec6\u7ebf\u5143\u7d20**,\u56e0\u4e3a\u5b83\u4eec\u63ed\u793a\u4e86\u6a21\u578b\u7684\u9519\u8bef \u6a21\u5f0f\u3002\u4f8b\u5982,**\u5047\u6b63\u4f8b(\\***FP)**\u8868\u793a\u6a21\u578b\u5c06\u8d1f\u7c7b\u8bef\u5224\u4e3a\u6b63\u7c7b\u7684\u6570\u91cf,\u2f7d**\u5047\u8d1f\u4f8b(FN)\u8868\u793a\u6a21\u578b \u6f0f\u5224\u7684\u6b63\u7c7b\u6837\u672c\u3002\u5982\u679cFP\u8f83\u2fbc,\u8bf4\u660e\u6a21\u578b\u5b58\u5728\u8fc7\u5ea6\u9884\u6d4b\u6b63\u7c7b\u7684\u503e\u5411;\u5982\u679cFN\u8f83\u2fbc,\u5219\u53ef\u80fd\u610f \u5473\u7740\u6a21\u578b\u8fc7\u4e8e\u4fdd\u5b88,\u6f0f\u6389\u4e86\u8bb8\u591a\u5b9e\u9645\u7684\u6b63\u7c7b\u6837\u672c\u3002\n\n\u5728\u591a\u5206\u7c7b\u95ee\u9898\u4e2d,\u6df7\u6dc6\u77e9\u9635\u7684\u89e3\u8bfb\u66f4\u52a0\u7ec6\u81f4\u3002\u6211\u4eec\u53ef\u4ee5\u89c2\u5bdf\u54ea\u4e9b\u7c7b\u522b\u5bb9\u6613\u88ab\u6df7\u6dc6,\u2f50\u5982\u7c7b\u522bA \u7684\u6837\u672c\u662f\u5426\u7ecf\u5e38\u88ab\u8bef\u5224\u4e3a\u7c7b\u522bB,\u8fd9\u53ef\u80fd\u610f\u5473\u7740\u8fd9\u4e24\u4e2a\u7c7b\u522b\u5728\u7279\u5f81\u4e0a\u8f83\u4e3a\u76f8\u4f3c,\u9700\u8981\u8fdb\u2f00\u6b65\u4f18 \u5316\u6a21\u578b\u6216\u8c03\u6574\u7279\u5f81\u2f2f\u7a0b\u3002\n\n# 4. \u793a\u4f8b\u89e3\u8bfb", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 944, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "8bfa5e74-a906-428b-83b5-6b4b0992a286": {"__data__": {"id_": "8bfa5e74-a906-428b-83b5-6b4b0992a286", "embedding": null, "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc", "node_type": "4", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "6971639435ca4e8b816c79535888daf2db8497c96ffac8510fd86bb1384292f0", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "1260a542-355d-4d34-a165-88fb1d1560fc", "node_type": "1", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "7fa690c9904ec25b42096685bdc1e279a7d352ca432ae97aeb8590015cebae5a", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "02adfdae-7d3b-4a04-bc34-7dfaa4f45e81", "node_type": "1", "metadata": {}, "hash": "22b043dbc52a04f0b4fde7fc575a49da847b3906f8d655d5d276df9e8b017f60", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "\u5728\u591a\u5206\u7c7b\u95ee\u9898\u4e2d,\u6df7\u6dc6\u77e9\u9635\u7684\u89e3\u8bfb\u66f4\u52a0\u7ec6\u81f4\u3002\u6211\u4eec\u53ef\u4ee5\u89c2\u5bdf\u54ea\u4e9b\u7c7b\u522b\u5bb9\u6613\u88ab\u6df7\u6dc6,\u2f50\u5982\u7c7b\u522bA \u7684\u6837\u672c\u662f\u5426\u7ecf\u5e38\u88ab\u8bef\u5224\u4e3a\u7c7b\u522bB,\u8fd9\u53ef\u80fd\u610f\u5473\u7740\u8fd9\u4e24\u4e2a\u7c7b\u522b\u5728\u7279\u5f81\u4e0a\u8f83\u4e3a\u76f8\u4f3c,\u9700\u8981\u8fdb\u2f00\u6b65\u4f18 \u5316\u6a21\u578b\u6216\u8c03\u6574\u7279\u5f81\u2f2f\u7a0b\u3002\n\n# 4. \u793a\u4f8b\u89e3\u8bfb\n\nImage /page/1/Figure/1 description: The image displays a confusion matrix, which is a table used to describe the performance of a classification model. The matrix has four rows and four columns, representing four classes (labeled 0, 1, 2, and 3) for both actual and predicted values. The cells contain numerical values indicating the counts of true positives, false positives, true negatives, and false negatives.\n\n- The top-left cell (actual 0, predicted 0) has the highest value of 252, shown in dark blue, indicating a high number of correct predictions for class 0.\n- Other notable values include: \n - Actual 0, Predicted 1: 17\n - Actual 1, Predicted 1: 40\n - Actual 2, Predicted 2: 16\n - Actual 3, Predicted 3: 12", "mimetype": "text/plain", "start_char_idx": 838, "end_char_idx": 1664, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "02adfdae-7d3b-4a04-bc34-7dfaa4f45e81": {"__data__": {"id_": "02adfdae-7d3b-4a04-bc34-7dfaa4f45e81", "embedding": null, "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc", "node_type": "4", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "6971639435ca4e8b816c79535888daf2db8497c96ffac8510fd86bb1384292f0", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "8bfa5e74-a906-428b-83b5-6b4b0992a286", "node_type": "1", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "8447f1fbcbf1b80e001e382a70c6c431a5de065154a41e302afbbb41669f839b", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "85cecd54-ccee-4d01-9d7e-069bacc091ef", "node_type": "1", "metadata": {}, "hash": "0b83793a2832fb5ad414795048b298f3aeb05368b2fc2dca10083fab9cac8121", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "The color intensity varies from light blue to dark blue, with a color bar on the right side indicating the scale from 0 to 250. The title 'Confusion Matrix' is centered at the top of the image. The x-axis is labeled 'Predicted,' and the y-axis is labeled 'Actual.'\n\n```\n\u603b\u5171\u6709 4 \u4e2a\u7c7b\u522b,\u7f16\u53f7\u4e3a 0, 1, 2, 3 \u3002\n```\n\n\u6a2a\u8f74\u662f\u6a21\u578b\u7684 **\u9884\u6d4b\u7ed3\u679c**(Predicted)\n\n\u7eb5\u8f74\u662f **\u771f\u5b9e\u6807\u7b7e**(Actual)\n\n\u4ece\u56fe\u4e2d\u53ef\u4ee5\u770b\u51fa,\u77e9\u9635\u7684\u7eb5\u8f74\u8868\u793a\u771f\u5b9e\u7c7b\u522b(Actual),\u6a2a\u8f74\u8868\u793a\u6a21\u578b\u7684\u9884\u6d4b\u7ed3\u679c (Predicted),\u989c\u2f8a\u8d8a\u6df1\u4ee3\u8868\u6837\u672c\u6570\u91cf\u8d8a\u591a\u3002\u5206\u6790\u4ece\u6bcf\u2f00\u4e2a\u5b9e\u9645\u7c7b\u522b\u7684\u9884\u6d4b\u8868\u73b0\u51fa\u53d1\u3002\n\n- \u5148\u770b\u7c7b\u522b0,\u8fd9\u662f\u6837\u672c\u6570\u6700\u591a\u7684\u2f00\u7c7b,\u5171\u6709272\u4e2a\u6837\u672c,\u5176\u4e2d\u6709252\u4e2a\u88ab\u6b63\u786e\u5206\u7c7b,\u5360\u2f50\u8fbe \u523092.3%\u3002\u8fd9\u8bf4\u660e\u6a21\u578b\u5728\u8bc6\u522b\u7c7b\u522b0\u2f45\u2faf\u8868\u73b0\u2fae\u5e38\u51fa\u2f8a,\u4ec5\u6709\u6781\u5c11\u6570(17\u4e2a\u88ab\u8bef\u5224\u4e3a\u7c7b\u522b 1,2\u4e2a\u4e3a\u7c7b\u522b2,1\u4e2a\u4e3a\u7c7b\u522b3)\u88ab\u9519\u5206\u3002\n- \u7c7b\u522b1\u7684\u8868\u73b0\u4e2d\u7b49,\u603b\u517175\u4e2a\u6837\u672c\u4e2d\u4ec5\u670940\u4e2a\u88ab\u6b63\u786e\u5206\u7c7b,\u5360\u2f5053.3%,\u5176\u4f59\u88ab\u8bef\u5206\u7c7b\u4e3a \u7c7b\u522b0(25\u4e2a)\u3001\u7c7b\u522b2(9\u4e2a)\u548c\u7c7b\u522b3(1\u4e2a),\u8868\u660e\u6a21\u578b\u5728\u7c7b\u522b1\u4e0e\u5176\u4ed6\u7c7b\u522b\u7684\u8fb9\u754c\u4e0a \u53ef\u80fd\u5b58\u5728\u2f00\u5b9a\u6a21\u7cca\u3002\n\n- \u66f4\u4e25\u91cd\u7684\u95ee\u9898\u51fa\u73b0\u5728\u7c7b\u522b2,\u5171\u670928\u4e2a\u6837\u672c,\u4ec5\u67094\u4e2a\u88ab\u6b63\u786e\u8bc6\u522b,\u51c6\u786e\u7387\u4ec5\u4e3a11.8%, \u2f24\u90e8\u5206\u88ab\u9519\u8bef\u5206\u7c7b\u4e3a\u7c7b\u522b1(16\u4e2a)\u548c\u7c7b\u522b0(5\u4e2a),\u8fd9\u8bf4\u660e\u6a21\u578b\u2f0f\u4e4e\u2f46\u6cd5\u6709\u6548\u533a\u5206\u7c7b\u522b 2,\u53ef\u80fd\u7531\u4e8e\u7c7b\u522b\u7279\u5f81\u4e0d\u660e\u663e\u3001\u6837\u672c\u8fc7\u5c11\u6216\u6570\u636e\u672c\u8eab\u5b58\u5728\u566a\u58f0\u3002\n- \u7c7b\u522b3\u5171\u670924\u4e2a\u6837\u672c,\u5176\u4e2d12\u4e2a\u88ab\u6b63\u786e\u9884\u6d4b,\u51c6\u786e\u7387\u4e3a48%,\u5176\u4f59\u88ab\u9519\u8bef\u5206\u914d\u4e3a\u7c7b\u522b0 (1\u4e2a)\u3001\u7c7b\u522b1(4\u4e2a)\u548c\u7c7b\u522b2(7\u4e2a),\u8bf4\u660e\u6a21\u578b\u5bf9\u7c7b\u522b3\u7684\u8bc6\u522b\u80fd\u2f12\u4e5f\u8f83\u4e3a\u6709\u9650\u3002\n\n\u4ece\u6574\u4f53\u8868\u73b0\u6765\u770b,\u8be5\u6a21\u578b\u5728\u2faf\u5bf9\u7c7b\u522b\u5206\u5e03\u4e0d\u5747\u7684\u6570\u636e\u65f6,\u5c55\u73b0\u51fa\u4e86\u660e\u663e\u7684\u504f\u5411\u6027\u3002\u5c24\u5176\u662f\u5bf9 \u7c7b\u522b0\u7684\u504f\u597d\u9884\u6d4b\u8868\u660e\u8be5\u7c7b\u522b\u5728\u8bad\u7ec3\u96c6\u4e2d\u7684\u5360\u2f50\u53ef\u80fd\u8fdc\u2fbc\u4e8e\u5176\u4ed6\u7c7b\u522b,\u5bfc\u81f4\u6a21\u578b\u5728\u4f18\u5316\u8fc7\u7a0b\u4e2d \u503e\u5411\u4e8e\u6700\u2f24\u5316\u8be5\u7c7b\u7684\u51c6\u786e\u7387,\u727a\u7272\u4e86\u5bf9\u5176\u4ed6\u7c7b\u522b\u7684\u8bc6\u522b\u80fd\u2f12\u3002", "mimetype": "text/plain", "start_char_idx": 1666, "end_char_idx": 2624, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "85cecd54-ccee-4d01-9d7e-069bacc091ef": {"__data__": {"id_": "85cecd54-ccee-4d01-9d7e-069bacc091ef", "embedding": null, "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc", "node_type": "4", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "6971639435ca4e8b816c79535888daf2db8497c96ffac8510fd86bb1384292f0", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "02adfdae-7d3b-4a04-bc34-7dfaa4f45e81", "node_type": "1", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "7cc29e91be74fd66959ce28edc213e5b16418568123147d96f62e7af0c91c3a4", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "62f62bcb-fe45-4b45-9512-8a637f085b2a", "node_type": "1", "metadata": {}, "hash": "4da91bb56b0c750ad95264fd44f32a8e01b60b377944f7c11bf76552c3628a59", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "\u4ece\u6574\u4f53\u8868\u73b0\u6765\u770b,\u8be5\u6a21\u578b\u5728\u2faf\u5bf9\u7c7b\u522b\u5206\u5e03\u4e0d\u5747\u7684\u6570\u636e\u65f6,\u5c55\u73b0\u51fa\u4e86\u660e\u663e\u7684\u504f\u5411\u6027\u3002\u5c24\u5176\u662f\u5bf9 \u7c7b\u522b0\u7684\u504f\u597d\u9884\u6d4b\u8868\u660e\u8be5\u7c7b\u522b\u5728\u8bad\u7ec3\u96c6\u4e2d\u7684\u5360\u2f50\u53ef\u80fd\u8fdc\u2fbc\u4e8e\u5176\u4ed6\u7c7b\u522b,\u5bfc\u81f4\u6a21\u578b\u5728\u4f18\u5316\u8fc7\u7a0b\u4e2d \u503e\u5411\u4e8e\u6700\u2f24\u5316\u8be5\u7c7b\u7684\u51c6\u786e\u7387,\u727a\u7272\u4e86\u5bf9\u5176\u4ed6\u7c7b\u522b\u7684\u8bc6\u522b\u80fd\u2f12\u3002\n\n\u7c7b\u522b1\u4e0e\u7c7b\u522b3\u7684\u51c6\u786e\u7387\u7565\u2fbc\u4e8e\u968f\u673a\u2f54\u5e73,\u53ef\u80fd\u4ecd\u6709\u2f00\u5b9a\u7684\u8bc6\u522b\u4f9d\u636e,\u4f46\u8868\u73b0\u4f9d\u7136\u4e0d\u80fd\u4ee4 \u2f08\u6ee1\u610f\u3002\u7279\u522b\u662f\u7c7b\u522b2\u7684\u9884\u6d4b\u2f0f\u4e4e\u5b8c\u5168\u5931\u8d25,\u503c\u5f97\u5f15\u8d77\u91cd\u89c6\u3002\n\n\u4e3a\u4e86\u6539\u8fdb\u8be5\u6a21\u578b\u7684\u8868\u73b0,\u53ef\u4ee5\u8003\u8651\u4ece\u4ee5\u4e0b\u2f0f\u4e2a\u2f45\u5411\u7740\u2f3f:\n\n- \u5904\u7406\u7c7b\u522b\u4e0d\u5e73\u8861\u95ee\u9898,\u2f50\u5982\u901a\u8fc7\u8fc7\u91c7\u6837(SMOTE)\u3001\u2f4b\u91c7\u6837\u6216\u7c7b\u522b\u52a0\u6743\u7b49\u2f45\u5f0f,\u589e\u5f3a\u5c11 \u6570\u7c7b\u7684\u5b66\u4e60\u6743\u91cd;\n- \u52a0\u5f3a\u7279\u5f81\u2f2f\u7a0b,\u5bf9\u8868\u73b0\u5dee\u7684\u7c7b\u522b\u8fdb\u2f00\u6b65\u63a2\u7d22\u5176\u7279\u5f81\u5206\u5e03,\u5224\u65ad\u662f\u5426\u5b58\u5728\u663e\u8457\u91cd\u53e0\u6216\u7f3a\u4e4f\u5224 \u522b\u2f12\u7684\u7ef4\u5ea6,\u5fc5\u8981\u65f6\u53ef\u4ee5\u5c1d\u8bd5\u964d\u7ef4\u6216\u6784\u9020\u65b0\u7279\u5f81\n- \u5728\u6a21\u578b\u9009\u62e9\u2f45\u2faf,\u53ef\u4ee5\u4f7f\u2f64\u66f4\u5f3a\u7684\u96c6\u6210\u5b66\u4e60\u6a21\u578b(\u5982XGBoost\u3001LightGBM\u6216CatBoost) \u6216\u91c7\u2f64\u6df1\u5ea6\u5b66\u4e60\u6a21\u578b\u8fdb\u2f8f\u66f4\u590d\u6742\u7684\u7279\u5f81\u62df\u5408;\n\n## **ROC curve, AUC**\n\n### 1. \u4ec0\u4e48\u662fROC\u548cAUC?\n\nROC AUC \u66f2\u7ebf(Receiver Operating Characteristic - Area Under the Curve)\u662f\u673a\u5668\u5b66\u4e60\u4e2d \u2f64\u6765\u8bc4\u4f30\u2f06\u5206\u7c7b\u6a21\u578b\u6027\u80fd\u7684\u7ecf\u5178\u2f2f\u5177,\u5c24\u5176\u9002\u2f64\u4e8e\u6837\u672c\u7c7b\u522b\u4e0d\u5e73\u8861\u7684\u60c5\u51b5\u3002ROC \u66f2\u7ebf\u7684\u672c\u8d28 \u662f\u5728\u4e0d\u540c\u7684\u5206\u7c7b\u9608\u503c\u4e0b,\u8861\u91cf\u6a21\u578b\u5bf9\u6b63\u8d1f\u6837\u672c\u7684\u533a\u5206\u80fd\u2f12,\u5b83\u901a\u8fc7\u7ed8\u5236\u771f\u6b63\u7387(True Positive Rate, TPR)\u4e0e\u5047\u6b63\u7387(False Positive Rate, FPR)\u4e4b\u95f4\u7684\u5173\u7cfb\u6765\u6784\u9020\u66f2\u7ebf,\u4ece\u2f7d\u53cd\u6620\u6a21\u578b\u6574 \u4f53\u9884\u6d4b\u6027\u80fd\u3002TPR,\u4e5f\u79f0\u4e3a\u53ec\u56de\u7387(Recall),\u8868\u793a\u6240\u6709\u5b9e\u9645\u4e3a\u6b63\u7c7b\u7684\u6837\u672c\u4e2d\u88ab\u6a21\u578b\u6210\u529f\u8bc6\u522b \u51fa\u6765\u7684\u2f50\u4f8b;\u2f7d FPR \u5219\u662f\u6240\u6709\u5b9e\u9645\u4e3a\u8d1f\u7c7b\u7684\u6837\u672c\u4e2d\u88ab\u8bef\u5224\u4e3a\u6b63\u7c7b\u7684\u2f50\u4f8b\u3002\n\nROC\u66f2\u7ebf\u7ed8\u5236\u65f6,\u5c06FPR\u4f5c\u4e3a\u6a2a\u8f74,TPR\u4f5c\u4e3a\u7eb5\u8f74\u3002\u5728\u5206\u7c7b\u6a21\u578b\u4e2d,\u5f80\u5f80\u4f1a\u6709\u2f00\u4e2a\u6982\u7387\u8f93\u51fa \u6216\u8005\u5f97\u5206(score),\u2f50\u5982\u903b\u8f91\u56de\u5f52\u8f93\u51fa\u9884\u6d4b\u4e3a\u6b63\u7c7b\u7684\u6982\u7387\u3002\u901a\u8fc7\u8c03\u6574\u8fd9\u4e2a\u6982\u7387\u7684\u9608\u503c\n\n(threshold),\u6211\u4eec\u53ef\u4ee5\u5f97\u5230\u4e0d\u540c\u7684\u5206\u7c7b\u7ed3\u679c\u3002\u9608\u503c\u8d8a\u4f4e,\u5224\u5b9a\u4e3a\u6b63\u7c7b\u7684\u6837\u672c\u8d8a\u591a,TPR\u548c FPR\u90fd\u53ef\u80fd\u4e0a\u5347;\u9608\u503c\u8d8a\u2fbc,\u6a21\u578b\u8d8a\u4e25\u683c,\u5224\u5b9a\u4e3a\u6b63\u7c7b\u7684\u6837\u672c\u51cf\u5c11,TPR\u548cFPR\u90fd\u53ef\u80fd\u964d\u4f4e\u3002\n\n\u2f7d AUC(Area Under the Curve)\u6b63\u662f\u8be5 ROC \u66f2\u7ebf\u4e0b\u7684\u2faf\u79ef,\u6570\u503c\u8303\u56f4\u57280\u52301\u4e4b\u95f4\u3002\n\n#### 2. \u5982\u4f55\u89e3\u8bfb?", "mimetype": "text/plain", "start_char_idx": 2514, "end_char_idx": 3511, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "62f62bcb-fe45-4b45-9512-8a637f085b2a": {"__data__": {"id_": "62f62bcb-fe45-4b45-9512-8a637f085b2a", "embedding": null, "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc", "node_type": "4", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "6971639435ca4e8b816c79535888daf2db8497c96ffac8510fd86bb1384292f0", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "85cecd54-ccee-4d01-9d7e-069bacc091ef", "node_type": "1", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "b07cce23d969679017c1e9fa9e62973c1a1b546732a9c9d8f06cc189d3c39820", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "6a653841-0e7f-4471-8b39-09ae0aba6652", "node_type": "1", "metadata": {}, "hash": "74e2487fc3a58914d5579ad98987e120ee9a886067171db5cb6e83991286c4e2", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "(threshold),\u6211\u4eec\u53ef\u4ee5\u5f97\u5230\u4e0d\u540c\u7684\u5206\u7c7b\u7ed3\u679c\u3002\u9608\u503c\u8d8a\u4f4e,\u5224\u5b9a\u4e3a\u6b63\u7c7b\u7684\u6837\u672c\u8d8a\u591a,TPR\u548c FPR\u90fd\u53ef\u80fd\u4e0a\u5347;\u9608\u503c\u8d8a\u2fbc,\u6a21\u578b\u8d8a\u4e25\u683c,\u5224\u5b9a\u4e3a\u6b63\u7c7b\u7684\u6837\u672c\u51cf\u5c11,TPR\u548cFPR\u90fd\u53ef\u80fd\u964d\u4f4e\u3002\n\n\u2f7d AUC(Area Under the Curve)\u6b63\u662f\u8be5 ROC \u66f2\u7ebf\u4e0b\u7684\u2faf\u79ef,\u6570\u503c\u8303\u56f4\u57280\u52301\u4e4b\u95f4\u3002\n\n#### 2. \u5982\u4f55\u89e3\u8bfb?\n\n\u7406\u60f3\u60c5\u51b5\u4e0b,\u2f00\u4e2a\u5b8c\u7f8e\u5206\u7c7b\u5668\u80fd\u5728\u4f4e FPR \u65f6\u8fbe\u5230\u2fbc TPR,ROC \u66f2\u7ebf\u5c06\u9760\u8fd1\u5de6\u4e0a\u2ec6,\u5f62\u6210\u2f00 \u6761\u63a5\u8fd1\u5782\u76f4\u540e\u2f54\u5e73\u7684\u66f2\u7ebf\u3002\u2f7d\u2f00\u4e2a\u968f\u673a\u731c\u6d4b\u7684\u5206\u7c7b\u5668,\u5176 TPR \u548c FPR \u968f\u9608\u503c\u53d8\u5316\u8fd1\u4f3c\u7b49\u2f50 \u589e\u2ed3,ROC \u66f2\u7ebf\u8fd1\u4f3c\u2f00\u6761\u5bf9\u2ec6\u7ebf(TPR = FPR),\u8fd9\u4ee3\u8868\u6a21\u578b\u6ca1\u6709\u5b66\u4e60\u5230\u6709\u2f64\u7684\u4fe1\u606f\u3002\n\nAUC \u503c\u8d8a\u63a5\u8fd11,\u8bf4\u660e\u6a21\u578b\u8d8a\u63a5\u8fd1\u5b8c\u7f8e\u5206\u7c7b;AUC \u4e3a0.5\u8868\u793a\u6a21\u578b\u6ca1\u6709\u533a\u5206\u80fd\u2f12,\u4e0e\u968f\u673a\u5206\u7c7b \u76f8\u540c;\u2f7d AUC \u2f29\u4e8e0.5 \u8bf4\u660e\u6a21\u578b\u5728\u9884\u6d4b\u6b63\u8d1f\u7c7b\u522b\u65f6\u53cd\u5411\u5b66\u4e60,\u751a\u2f84\u53ef\u4ee5\u901a\u8fc7\u5c06\u9884\u6d4b\u53cd\u8f6c\u6765\u63d0 \u2fbc\u6027\u80fd\u3002AUC \u6709\u2f00\u4e2a\u76f4\u89c2\u7684\u89e3\u91ca:\u5b83\u7b49\u4ef7\u4e8e\u968f\u673a\u9009\u53d6\u2f00\u4e2a\u6b63\u7c7b\u6837\u672c\u548c\u2f00\u4e2a\u8d1f\u7c7b\u6837\u672c,\u6a21\u578b\u5c06 \u6b63\u7c7b\u6392\u5728\u8d1f\u7c7b\u4e4b\u524d\u7684\u6982\u7387\u3002\u8fd9\u79cd\u6982\u7387\u610f\u4e49\u2fae\u5e38\u76f4\u89c2,\u5c24\u5176\u5728\u5b58\u5728\u6837\u672c\u4e0d\u5e73\u8861\u6216\u9608\u503c\u4e0d\u56fa\u5b9a \u65f6,AUC \u63d0\u4f9b\u4e86\u2f50 Accuracy \u66f4\u7a33\u5065\u7684\u8bc4\u4f30\u6807\u51c6\u3002\n\n\u4f7f\u2f64 ROC AUC \u6709\u2f0f\u70b9\u9700\u8981\u6ce8\u610f\u3002\u2fb8\u5148,\u5b83\u53ea\u5173\u6ce8\u6392\u5e8f,\u4e0d\u8003\u8651\u5b9e\u9645\u6982\u7387\u503c\u7684\u7edd\u5bf9\u51c6\u786e\u6027\u3002 \u56e0\u6b64\u2f00\u4e2a\u6982\u7387\u9884\u6d4b\u6a21\u578b\u5373\u4f7f\u5206\u6570\u504f\u79bb\u771f\u5b9e\u6982\u7387\u5f88\u8fdc,\u53ea\u8981\u6392\u5e8f\u6b63\u786e,AUC \u4ecd\u7136\u53ef\u80fd\u5f88\u2fbc\u3002\u5176 \u6b21,\u5728\u6781\u5ea6\u7c7b\u522b\u4e0d\u5e73\u8861\u7684\u60c5\u51b5\u4e0b,\u867d\u7136 AUC \u80fd\u4fdd\u6301\u7a33\u5b9a,\u4f46\u5b9e\u9645\u4e1a\u52a1\u53ef\u80fd\u66f4\u5173\u2f3c\u7279\u5b9a\u53ec\u56de\u7387 \u4e0b\u7684\u7cbe\u786e\u7387(Precision),\u6b64\u65f6 PR \u66f2\u7ebf\u548c PR-AUC \u66f4\u5408\u9002\u3002\u6b64\u5916,ROC \u66f2\u7ebf\u9002\u2f64\u4e8e\u2f06\u5206\u7c7b \u4efb\u52a1,\u5bf9\u4e8e\u591a\u5206\u7c7b\u4efb\u52a1,\u901a\u5e38\u901a\u8fc7 One-vs-Rest(OvR)\u7b56\u7565\u5c06\u95ee\u9898\u8f6c\u5316\u4e3a\u591a\u4e2a\u2f06\u5206\u7c7b\u2f26\u95ee \u9898,\u5206\u522b\u8ba1\u7b97\u6bcf\u2f00\u7c7b\u7684 ROC AUC,\u6700\u540e\u6c42\u5e73\u5747(\u5b8f\u5e73\u5747\u6216\u52a0\u6743\u5e73\u5747)\u5f97\u5230\u603b\u4f53\u6307\u6807\u3002\n\n3. \u793a\u4f8b\u89e3\u8bfb", "mimetype": "text/plain", "start_char_idx": 3350, "end_char_idx": 4143, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "6a653841-0e7f-4471-8b39-09ae0aba6652": {"__data__": {"id_": "6a653841-0e7f-4471-8b39-09ae0aba6652", "embedding": null, "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc", "node_type": "4", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "6971639435ca4e8b816c79535888daf2db8497c96ffac8510fd86bb1384292f0", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "62f62bcb-fe45-4b45-9512-8a637f085b2a", "node_type": "1", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "6a197cbaa73e87a3b0e373c73dc00043c01e4346cd5f7569d6c8fc66ae5aeac1", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "9c551fac-eaae-42d7-9d64-c473d133b9c3", "node_type": "1", "metadata": {}, "hash": "bbd3b518822723787219376768d34475cbbb6e2a5bfe1b553b0ec2bb34d4cc72", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "3. \u793a\u4f8b\u89e3\u8bfb\n\nImage /page/4/Figure/0 description: This image is a Receiver Operating Characteristic (ROC) curve graph comparing the performance of three different models: 'Methyl+Exp', 'Methylation', and 'Expression'. The x-axis represents '1 - Specificity' ranging from 0.0 to 1.0, while the y-axis represents 'Sensitivity', also ranging from 0.0 to 1.0. Each model's performance is depicted by a distinct line:\n- 'Methyl+Exp' is represented by a solid black line with an Area Under the Curve (AUC) value of 0.947.\n- 'Methylation' is shown by a dotted blue line with an AUC value of 0.897.\n- 'Expression' is illustrated by a dashed red line with an AUC value of 0.846.\nThe graph includes a diagonal gray line representing a random classifier for reference. The legend in the lower right corner identifies each line and its corresponding AUC value.\n\n\u8fd9\u5f20\u56fe\u5c55\u793a\u7684\u662f\u2f00\u4e2a\u591a\u6a21\u578b\u2f50\u8f83\u7684\u53d7\u8bd5\u8005\u2f2f\u4f5c\u7279\u5f81\u66f2\u7ebf(ROC Curve),\u2f64\u4e8e\u8bc4\u4f30\u4e0d\u540c\u7279\u5f81 \u7ec4\u5408\u5728\u4e73\u817a\u764c\u68c0\u6d4b\u4e2d\u7684\u5206\u7c7b\u6027\u80fd", "mimetype": "text/plain", "start_char_idx": 4136, "end_char_idx": 5040, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "9c551fac-eaae-42d7-9d64-c473d133b9c3": {"__data__": {"id_": "9c551fac-eaae-42d7-9d64-c473d133b9c3", "embedding": null, "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc", "node_type": "4", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "6971639435ca4e8b816c79535888daf2db8497c96ffac8510fd86bb1384292f0", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "6a653841-0e7f-4471-8b39-09ae0aba6652", "node_type": "1", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "0eaeae9b4a4d125a9ce9e50507ae358ce758af8891428542813466cfff06a49b", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "e9776421-05dc-46cd-8de4-5dddc98eaf4f", "node_type": "1", "metadata": {}, "hash": "65faad1571d5e26a9de96568175d1996e1f9b8261f40ce8afe7feac9d2eef140", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "\u8fd9\u5f20\u56fe\u5c55\u793a\u7684\u662f\u2f00\u4e2a\u591a\u6a21\u578b\u2f50\u8f83\u7684\u53d7\u8bd5\u8005\u2f2f\u4f5c\u7279\u5f81\u66f2\u7ebf(ROC Curve),\u2f64\u4e8e\u8bc4\u4f30\u4e0d\u540c\u7279\u5f81 \u7ec4\u5408\u5728\u4e73\u817a\u764c\u68c0\u6d4b\u4e2d\u7684\u5206\u7c7b\u6027\u80fd\n\n\u6761\u66f2\u7ebf\u4ee3\u8868\u2f00\u4e2a\u6a21\u578b\u7684\u8868\u73b0:\u2fca\u2f8a\u5b9e\u7ebf\u8868\u793a\u7ed3\u5408\u7532\u57fa\u5316\u548c\u57fa\u56e0\u8868\u8fbe(Methyl+Exp)\u7684\u6a21\u578b, \u84dd\u2f8a\u865a\u7ebf\u8868\u793a\u4ec5\u4f7f\u2f64\u7532\u57fa\u5316\u7279\u5f81(Methylation)\u7684\u6a21\u578b,\u7ea2\u2f8a\u865a\u7ebf\u5219\u4ee3\u8868\u4ec5\u4f7f\u2f64\u57fa\u56e0\u8868\u8fbe\u7279 \u5f81(Expression)\u7684\u6a21\u578b\u3002\u56fe\u4e2d\u53f3\u4e0b\u2ec6\u5217\u51fa\u4e86\u4e09\u6761\u66f2\u7ebf\u5bf9\u5e94\u7684AUC\u503c(\u66f2\u7ebf\u4e0b\u2faf\u79ef),\u5206\u522b \u4e3a0.947\u30010.897 \u548c 0.846,\u4ee3\u8868\u4e09\u79cd\u6a21\u578b\u7684\u6574\u4f53\u5206\u7c7b\u80fd\u2f12\u3002\n\n- \u4ece\u56fe\u4e2d\u53ef\u4ee5\u660e\u663e\u770b\u51fa,\u4e09\u6761\u66f2\u7ebf\u5747\u8fdc\u79bb\u968f\u673a\u5206\u7c7b\u7ebf(\u7070\u2f8a\u5bf9\u2ec6\u7ebf,AUC = 0.5),\u8868\u660e\u6240 \u6709\u6a21\u578b\u90fd\u5177\u6709\u663e\u8457\u7684\u9884\u6d4b\u80fd\u2f12\u3002\n- \u2fca\u2f8a\u5b9e\u7ebf\u7684Methyl+Exp\u6a21\u578b\u5728\u6574\u4e2a\u66f2\u7ebf\u8303\u56f4\u5185\u8868\u73b0\u6700\u4f18,\u5176AUC\u2fbc\u8fbe0.947,\u8bf4\u660e\u8be5\u6a21\u578b \u5728\u6240\u6709\u5206\u7c7b\u9608\u503c\u4e0b\u90fd\u80fd\u4fdd\u6301\u8f83\u2fbc\u7684\u654f\u611f\u6027\u548c\u7279\u5f02\u6027,\u2f0f\u4e4e\u63a5\u8fd1\u5b8c\u7f8e\u5206\u7c7b\u3002\n- \u84dd\u2f8a\u7684\u7532\u57fa\u5316\u6a21\u578b\u6b21\u4e4b,AUC\u4e3a0.897,\u4e5f\u8868\u73b0\u51fa\u2f8a,\u4f46\u76f8\u2f50\u2fca\u2f8a\u66f2\u7ebf\u7565\u6709\u4e0b\u964d\u3002\u7ea2\u2f8a\u7684 \u57fa\u56e0\u8868\u8fbe\u6a21\u578bAUC\u4e3a0.846,\u867d\u7136\u4ecd\u5177\u5907\u8f83\u5f3a\u7684\u5224\u522b\u2f12,\u4f46\u6027\u80fd\u660e\u663e\u4f4e\u4e8e\u5176\u4ed6\u4e24\u79cd\u6a21\u578b\u3002\n\n\u4ece\u66f2\u7ebf\u5f62\u6001\u6765\u770b,\u2fca\u2f8a\u66f2\u7ebf\u5728\u4f4e\u5047\u9633\u6027\u7387(1 - Specificity\u63a5\u8fd10)\u65f6\u7684\u654f\u611f\u6027\u660e\u663e\u2fbc\u4e8e\u5176 \u4ed6\u66f2\u7ebf,\u610f\u5473\u7740\u5728\u4fdd\u6301\u6781\u4f4e\u8bef\u62a5\u7387\u7684\u524d\u63d0\u4e0b\u4ecd\u80fd\u51c6\u786e\u8bc6\u522b\u51fa\u2f24\u591a\u6570\u771f\u5b9e\u75c5\u4f8b(\u2fbc\u7075\u654f \u5ea6)\u3002\u84dd\u2f8a\u66f2\u7ebf\u867d\u7136\u6574\u4f53\u4f18\u4e8e\u7ea2\u2f8a,\u4f46\u5728\u4e2d\u6bb5(\u5047\u9633\u6027\u73870.2~0.4\u533a\u95f4)\u8868\u73b0\u6ce2\u52a8,\u663e\u793a \u6a21\u578b\u5728\u90e8\u5206\u9608\u503c\u4e0b\u53ef\u80fd\u4e0d\u591f\u7a33\u5b9a\n\n\u7ed3\u8bba\u4e0e\u5efa\u8bae:\n\n- 1. **\u8054\u5408\u7279\u5f81\u7b56\u7565\u4f18\u8d8a**:Methyl+Exp\u6a21\u578b\u660e\u663e\u4f18\u4e8e\u4efb\u2f00\u5355\u72ec\u7279\u5f81\u6765\u6e90,\u8868\u660e\u878d\u5408\u7532\u57fa\u5316\u548c\u8868 \u8fbe\u6570\u636e\u53ef\u6709\u6548\u6355\u6349\u80bf\u7624\u53d1\u2f63\u673a\u5236\u7684\u4e0d\u540c\u7ef4\u5ea6,\u4ece\u2f7d\u63d0\u5347\u8bca\u65ad\u51c6\u786e\u6027\u3002\u5efa\u8bae\u5728\u5b9e\u9645\u6a21\u578b\u6784\u5efa \u4e2d\u4f18\u5148\u8003\u8651\u591a\u7ec4\u5b66\u6570\u636e\u878d\u5408\u3002\n- 2. **\u7532\u57fa\u5316\u4f18\u4e8e\u8868\u8fbe**:\u867d\u7136\u4e24\u8005\u90fd\u53ef\u4f5c\u4e3a\u4e73\u817a\u764c\u7684\u2f63\u7269\u6807\u5fd7\u7269,\u4f46\u672c\u56fe\u663e\u793a\u7532\u57fa\u5316\u4fe1\u606f\u63d0\u4f9b\u7684 \u5224\u522b\u2f12\u66f4\u5f3a(AUC 0.897 vs 0.846)\u3002\u8fd9\u6216\u8bb8\u53cd\u6620\u51faDNA\u7532\u57fa\u5316\u66f4\u65e9\u53d1\u2f63\u4e8e\u80bf\u7624\u53d1\u2f63\u8fc7 \u7a0b,\u66f4\u5177\u9884\u8b66\u80fd\u2f12\u3002\u5bf9\u4e8e\u8d44\u6e90\u53d7\u9650\u7684\u4e34\u5e8a\u573a\u666f,\u4f18\u5148\u8003\u8651\u7532\u57fa\u5316\u68c0\u6d4b\u53ef\u80fd\u66f4\u5177\u6027\u4ef7\u2f50\u3002\n\n# **PR Curve**\n\n### 1. \u4ec0\u4e48\u662fPR curve?", "mimetype": "text/plain", "start_char_idx": 4981, "end_char_idx": 5886, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "e9776421-05dc-46cd-8de4-5dddc98eaf4f": {"__data__": {"id_": "e9776421-05dc-46cd-8de4-5dddc98eaf4f", "embedding": null, "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc", "node_type": "4", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "6971639435ca4e8b816c79535888daf2db8497c96ffac8510fd86bb1384292f0", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "9c551fac-eaae-42d7-9d64-c473d133b9c3", "node_type": "1", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "9b8e452815a2cad19777d1e4c4d6cde2ef972735e39bf870f63004bbd4e65ff7", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "9caf447a-c377-49ae-a7ec-d8f76856868a", "node_type": "1", "metadata": {}, "hash": "54350f0c4b38c5abdec892407e918e422838cc83b82d96d654f81c2578342f96", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "# **PR Curve**\n\n### 1. \u4ec0\u4e48\u662fPR curve?\n\n\u5728\u2f06\u5206\u7c7b\u673a\u5668\u5b66\u4e60\u4efb\u52a1\u4e2d,\u5c24\u5176\u662f\u2faf\u5bf9\u7c7b\u522b\u4e0d\u5e73\u8861\u7684\u95ee\u9898\u65f6,Precision-Recall(PR)\u66f2\u7ebf\u6210 \u4e3a\u2f50\u4f20\u7edf ROC \u66f2\u7ebf\u66f4\u5177\u89e3\u91ca\u2f12\u548c\u5b9e\u2f64\u4ef7\u503c\u7684\u8bc4\u4f30\u2f2f\u5177\u3002PR \u66f2\u7ebf\u662f\u4ee5\u53ec\u56de\u7387(Recall,\u7075\u654f \u5ea6)\u4e3a\u6a2a\u8f74,\u7cbe\u786e\u7387(Precision)\u4e3a\u7eb5\u8f74\u6240\u7ed8\u5236\u7684\u2f06\u7ef4\u66f2\u7ebf,\u2f64\u4ee5\u8861\u91cf\u5206\u7c7b\u5668\u5728\u4e0d\u540c\u9608\u503c\u4e0b \u5bf9\u6b63\u7c7b\u6837\u672c\u7684\u8bc6\u522b\u80fd\u2f12\u3002\u5f53\u6211\u4eec\u5bf9\u2f00\u4e2a\u6837\u672c\u7684\u9884\u6d4b\u8f93\u51fa\u662f\u2f00\u4e2a\u6982\u7387\u503c(\u5982\u903b\u8f91\u56de\u5f52\u6216\u795e\u7ecf\u2f79 \u7edc\u7684 sigmoid \u8f93\u51fa),\u53ef\u4ee5\u901a\u8fc7\u4e0d\u65ad\u6539\u53d8\u5206\u7c7b\u9608\u503c,\u5f97\u5230\u2f00\u7cfb\u5217\u7684(Recall, Precision)\u70b9, \u8fdb\u2f7d\u6784\u6210\u5b8c\u6574\u7684 PR \u66f2\u7ebf\u3002\n\n- **Precision(\u7cbe\u786e\u7387)** \u8861\u91cf\u7684\u662f\u6a21\u578b\u6240\u6709\u9884\u6d4b\u4e3a\u6b63\u7c7b\u7684\u6837\u672c\u4e2d,\u6709\u591a\u5c11\u662f\u771f\u6b63\u7684\u6b63\u7c7b\n- **Recall(\u53ec\u56de\u7387)** \u8861\u91cf\u7684\u662f\u6240\u6709\u771f\u5b9e\u6b63\u7c7b\u6837\u672c\u4e2d,\u6709\u591a\u5c11\u88ab\u6a21\u578b\u6210\u529f\u8bc6\u522b\u51fa\u6765\n\n\u4e0e\u4f20\u7edf\u7684ROC\u66f2\u7ebf\u4e0d\u540c,PR\u66f2\u7ebf\u805a\u7126\u4e8e\u6b63\u7c7b\u7684\u9884\u6d4b\u8d28\u91cf,\u2f7d\u2fae\u5168\u5c40\u5206\u7c7b\u6027\u80fd,\u56e0\u6b64\u5f53\u6211\u4eec\u5904 \u7406\u5982\u75be\u75c5\u7b5b\u67e5\u3001\u7f55\u2ec5\u4e8b\u4ef6\u8bc6\u522b\u7b49\u6b63\u7c7b\u2f50\u4f8b\u6781\u4f4e\u7684\u4efb\u52a1\u65f6,PR\u66f2\u7ebf\u63d0\u4f9b\u4e86\u66f4\u654f\u611f\u3001\u66f4\u5177\u73b0\u5b9e\u610f \u4e49\u7684\u8bc4\u4f30\u2f45\u5f0f\u3002\n\n#### 2. \u5982\u4f55\u89e3\u8bfb?\n\n\u89e3\u8bfb\u2f00\u6761PR\u66f2\u7ebf\u65f6,\u6211\u4eec\u2fb8\u5148\u89c2\u5bdf\u5176\u6574\u4f53\u5f62\u72b6\u3002\u5982\u679c\u6a21\u578b\u8868\u73b0\u4f18\u79c0,PR\u66f2\u7ebf\u5e94\u5f53\u6574\u4f53\u4f4d\u4e8e\u56fe \u50cf\u7684\u53f3\u4e0a\u2ec6,\u610f\u5473\u7740\u5728\u2fbc\u53ec\u56de\u7387\u7684\u540c\u65f6\u4ecd\u80fd\u7ef4\u6301\u8f83\u2fbc\u7684\u7cbe\u786e\u7387\u3002\u8fd9\u662f\u2f00\u4e2a\u2fae\u5e38\u7406\u60f3\u4f46\u73b0\u5b9e\u4e2d \u96be\u4ee5\u5b9e\u73b0\u7684\u72b6\u6001,\u56e0\u4e3a\u5728\u5b9e\u8df5\u4e2d,Precision \u548c Recall \u5f80\u5f80\u5b58\u5728\u6743\u8861\u5173\u7cfb\u3002\u5f53\u6211\u4eec\u8c03\u6574\u6a21\u578b\u7684 \u5206\u7c7b\u9608\u503c\u4ee5\u6355\u6349\u66f4\u591a\u6b63\u7c7b(\u63d0\u2fbc Recall)\u65f6,\u5f80\u5f80\u4e5f\u4f1a\u589e\u52a0\u8bef\u8bc6\u522b\u7684\u8d1f\u7c7b\u6837\u672c\u6570\u91cf,\u5bfc\u81f4 Precision \u4e0b\u964d;\u76f8\u53cd,\u5f53\u6211\u4eec\u63d0\u2fbc\u5206\u7c7b\u7f6e\u4fe1\u5ea6\u8981\u6c42(\u63d0\u2fbc Precision),\u5219\u53ef\u80fd\u6f0f\u6389\u8bb8\u591a\u771f\u6b63 \u7684\u6b63\u7c7b,\u5bfc\u81f4 Recall \u964d\u4f4e\u3002\u56e0\u6b64,PR\u66f2\u7ebf\u2f00\u822c\u4ece\u5de6\u4e0a\u2ec6\u5f00\u59cb,\u968f\u7740\u53ec\u56de\u7387\u9010\u6b65\u4e0a\u5347,\u7cbe\u786e\u7387 \u5448\u4e0b\u964d\u8d8b\u52bf,\u6700\u7ec8\u8d8b\u4e8e\u6a21\u578b\u7684\u6700\u5dee\u72b6\u6001\u6216\u6b63\u7c7b\u2f50\u4f8b\u7684\u57fa\u51c6\u7ebf", "mimetype": "text/plain", "start_char_idx": 5851, "end_char_idx": 6656, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "9caf447a-c377-49ae-a7ec-d8f76856868a": {"__data__": {"id_": "9caf447a-c377-49ae-a7ec-d8f76856868a", "embedding": null, "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc", "node_type": "4", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "6971639435ca4e8b816c79535888daf2db8497c96ffac8510fd86bb1384292f0", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "e9776421-05dc-46cd-8de4-5dddc98eaf4f", "node_type": "1", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "27505e3abba7dbce469d96d00c80b8b1a543d76a7987efbc16246bc1decd3ac7", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "a5016720-3c16-43e7-934d-18d38cf7f8c7", "node_type": "1", "metadata": {}, "hash": "e12deb1612d5dcdaa898d4aa4f73e2f64f56ee44f21b5b29d4db4415d3bd50e5", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "PR\u66f2\u7ebf\u5bf9\u6b63\u7c7b\u6837\u672c\u7684\u2f50\u4f8b\u2fae\u5e38\u654f\u611f\u3002\u5982\u679c\u6b63\u7c7b\u6781\u5c11,\u90a3\u4e48\u5373\u4f7f\u9519\u8bef\u9884\u6d4b\u5c11\u91cf\u8d1f\u7c7b\u4e3a\u6b63\u7c7b,\u4e5f \u4f1a\u5bfc\u81f4 Precision \u6025\u5267\u4e0b\u964d;\u8fd9\u6b63\u662fPR\u66f2\u7ebf\u80fd\u5728\u7c7b\u522b\u4e0d\u5747\u8861\u4e2d\u51f8\u663e\u6a21\u578b\u6027\u80fd\u5dee\u5f02\u7684\u539f\u56e0\u3002\u5f53 \u89e3\u8bfb\u2f00\u5f20PR\u66f2\u7ebf\u65f6,\u6211\u4eec\u5e38\u4f1a\u5173\u6ce8\u5176\"\u2faf\u79ef\",\u5373\u5e73\u5747\u7cbe\u786e\u7387(Average Precision, AP),\u5b83 \u4ee3\u8868\u4e86PR\u66f2\u7ebf\u4e0b\u7684\u6574\u4f53\u2faf\u79ef,\u8d8a\u2f24\u8868\u793a\u6a21\u578b\u7efc\u5408\u6027\u80fd\u8d8a\u597d\u3002\u2f00\u4e2a\u5b8c\u7f8e\u7684\u5206\u7c7b\u5668\u7684PR\u66f2\u7ebf\u5c06\u662f \u2f00\u6761\u4f4d\u4e8e\u56fe\u50cf\u9876\u7aef\u7684\u2f54\u5e73\u7ebf,\u5176AP\u4e3a1,\u2f7d\u2f00\u4e2a\u968f\u673a\u731c\u6d4b\u7684\u5206\u7c7b\u5668\u7684\u7cbe\u786e\u7387\u5c06\u8d8b\u4e8e\u6b63\u7c7b\u7684\u57fa\u7ebf \u2f50\u4f8b,AP\u4f1a\u8f83\u4f4e\u3002\n\n### 3. \u793a\u4f8b\u89e3\u8bfb", "mimetype": "text/plain", "start_char_idx": 6658, "end_char_idx": 6910, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "a5016720-3c16-43e7-934d-18d38cf7f8c7": {"__data__": {"id_": "a5016720-3c16-43e7-934d-18d38cf7f8c7", "embedding": null, "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc", "node_type": "4", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "6971639435ca4e8b816c79535888daf2db8497c96ffac8510fd86bb1384292f0", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "9caf447a-c377-49ae-a7ec-d8f76856868a", "node_type": "1", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "7cf3bfbd997d9b6d170eb2a615c2f512eeef47694c62e8ec3240031052631866", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "79b57d73-7ee8-4e09-a312-c6731f20ae64", "node_type": "1", "metadata": {}, "hash": "1ae071d7ddfb68e62e26e9f03b6721abf80298c3af5a4ed24297e9f17027ea59", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Image /page/6/Figure/3 description: The image is a Precision-Recall Curve (PRC) graph comparing the performance of a model in classifying different stages of cognitive impairment. The x-axis represents 'Recall' ranging from 0.0 to 1.0, and the y-axis represents 'Precision,' also ranging from 0.0 to 1.0. There are four curves on the graph, each representing a different classification category:\n- A dotted pink line labeled 'PRC (AUC = 0.91)' which shows the overall performance.\n- A light gray dashed line labeled 'Mild cognitive impairment (AUC = 0.93)'.\n- A teal solid line labeled 'Mild dementia (AUC = 0.88)'.\n- A blue solid line labeled 'Moderate dementia (AUC = 0.88)'.\n- A black solid line labeled 'Severe dementia (AUC = 0.95)'.", "mimetype": "text/plain", "start_char_idx": 6912, "end_char_idx": 7650, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "79b57d73-7ee8-4e09-a312-c6731f20ae64": {"__data__": {"id_": "79b57d73-7ee8-4e09-a312-c6731f20ae64", "embedding": null, "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc", "node_type": "4", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "6971639435ca4e8b816c79535888daf2db8497c96ffac8510fd86bb1384292f0", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "a5016720-3c16-43e7-934d-18d38cf7f8c7", "node_type": "1", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "b22d155db786bb2e461831538815712e176c02f5625433bbde98f853cf436fe4", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "3743fede-e0af-465c-8255-6ba40e58462d", "node_type": "1", "metadata": {}, "hash": "3e2742abb0714e74bd966592c627c8b1998a7f317166fa3daa5df3a369752285", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "- A teal solid line labeled 'Mild dementia (AUC = 0.88)'.\n- A blue solid line labeled 'Moderate dementia (AUC = 0.88)'.\n- A black solid line labeled 'Severe dementia (AUC = 0.95)'.\nThe curves show that 'Severe dementia' has the highest Area Under the Curve (AUC) at 0.95, indicating the best precision-recall trade-off, followed by 'Mild cognitive impairment' at 0.93, 'PRC' at 0.91, and both 'Mild dementia' and 'Moderate dementia' at 0.88.", "mimetype": "text/plain", "start_char_idx": 7470, "end_char_idx": 7911, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "3743fede-e0af-465c-8255-6ba40e58462d": {"__data__": {"id_": "3743fede-e0af-465c-8255-6ba40e58462d", "embedding": null, "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc", "node_type": "4", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "6971639435ca4e8b816c79535888daf2db8497c96ffac8510fd86bb1384292f0", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "79b57d73-7ee8-4e09-a312-c6731f20ae64", "node_type": "1", "metadata": {"filename": "Confusion_matrix_0717.md", "extension": ".md"}, "hash": "19038e6ed5a2da91355cbe153fe79abb58a7ec299430d4aedf39f0429789d814", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "\u8fd9\u5f20\u7cbe\u786e\u7387-\u53ec\u56de\u7387(PR)\u66f2\u7ebf\u56fe\u5c55\u793a\u4e86\u673a\u5668\u5b66\u4e60\u6a21\u578b\u5728\u9884\u6d4b\u4e0d\u540c\u9636\u6bb5\u75f4\u5446\u75c7\u2f45\u2faf\u7684\u6027\u80fd\u8868\u73b0, \u4e3a\u6211\u4eec\u63d0\u4f9b\u4e86\u5173\u4e8e\u6a21\u578b\u8bca\u65ad\u51c6\u786e\u6027\u7684\u6df1\u2f0a\u6d1e\u5bdf\u3002\u4e0eROC\u66f2\u7ebf\u4e0d\u540c,PR\u66f2\u7ebf\u7279\u522b\u9002\u2f64\u4e8e\u4e0d\u5e73\u8861 \u6570\u636e\u96c6\u7684\u5206\u6790,\u2f7d\u5728\u75f4\u5446\u75c7\u8bca\u65ad\u4e2d,\u5065\u5eb7\u2f08\u7fa4\u8fdc\u591a\u4e8e\u60a3\u8005\u7684\u60c5\u51b5\u6b63\u662f\u4e0d\u5e73\u8861\u6570\u636e\u96c6\u7684\u5178\u578b\u573a \u666f\u3002\u56fe\u4e2d\u5c55\u793a\u4e86\u4e94\u4e2a\u4e0d\u540c\u75f4\u5446\u9636\u6bb5\u7684PR\u66f2\u7ebf\u53ca\u5176\u5bf9\u5e94\u7684AUC\u503c:\u524d\u9a71\u671f(PRC)\u4e3a0.91,\u8f7b\u5ea6 \u8ba4\u77e5\u969c\u788d(MCI)\u4e3a0.93,\u8f7b\u5ea6\u75f4\u5446\u4e3a0.88,\u4e2d\u5ea6\u75f4\u5446\u4e3a0.88,\u4ee5\u53ca\u91cd\u5ea6\u75f4\u5446\u4e3a0.95\u3002\u8fd9\u4e9bAUC \u503c\u6574\u4f53\u5904\u4e8e\u8f83\u2fbc\u2f54\u5e73,\u8868\u660e\u6a21\u578b\u5728\u5404\u7c7b\u75f4\u5446\u5206\u671f\u8bca\u65ad\u4e2d\u5747\u8868\u73b0\u51fa\u2f8a,\u5176\u4e2d\u5bf9\u91cd\u5ea6\u75f4\u5446\u7684\u8bc6\u522b \u80fd\u2f12\u6700\u4e3a\u7cbe\u51c6(AUC=0.95),\u2f7d\u5bf9\u8f7b\u5ea6\u75f4\u5446\u548c\u4e2d\u5ea6\u75f4\u5446\u7684\u8bc6\u522b\u76f8\u5bf9\u7a0d\u5f31,\u4f46\u4ecd\u4fdd\u6301\u5728\u8f83\u2fbc\u2f54\u5e73 (AUC=0.88)\u3002\n\n\u7406\u60f3\u60c5\u51b5\u4e0b,\u5b8c\u7f8e\u7684PR\u66f2\u7ebf\u5e94\u8be5\u4ece\u5de6\u4e0a\u2ec6(\u7cbe\u786e\u7387=1.0,\u53ec\u56de\u7387=1.0)\u5f00\u59cb,\u4fdd\u6301\u2fbc\u2f54\u5e73\u5411\u53f3\u5ef6 \u4f38\u3002\u672c\u6a21\u578b\u5728\u4f4e\u53ec\u56de\u7387\u533a\u57df(0.0-0.4)\u8868\u73b0\u51fa\u6781\u2fbc\u7684\u7cbe\u786e\u7387,\u8fd9\u610f\u5473\u7740\u5f53\u6a21\u578b\u4ee5\u8f83\u2fbc\u9608\u503c\u5224\u5b9a\u9633 \u6027\u75c5\u4f8b\u65f6,\u5176\u5224\u65ad\u6781\u4e3a\u53ef\u9760,\u2f0f\u4e4e\u4e0d\u4f1a\u4ea7\u2f63\u8bef\u8bca\u3002\u968f\u7740\u53ec\u56de\u7387\u63d0\u2fbc\u2f840.6-0.8\u8303\u56f4,\u7cbe\u786e\u7387\u5f00 \u59cb\u51fa\u73b0\u4e0d\u540c\u7a0b\u5ea6\u7684\u4e0b\u6ed1,\u8fd9\u79cd\u53d8\u5316\u6a21\u5f0f\u7b26\u5408\u9884\u671f,\u56e0\u4e3a\u63d0\u2fbc\u75be\u75c5\u68c0\u51fa\u7387(\u53ec\u56de\u7387)\u901a\u5e38\u9700\u8981\u4ee5\u63a5 \u53d7\u66f4\u591a\u5047\u9633\u6027\u75c5\u4f8b(\u964d\u4f4e\u7cbe\u786e\u7387)\u4e3a\u4ee3\u4ef7\u3002\u7279\u522b\u503c\u5f97\u6ce8\u610f\u7684\u662f,\u5728\u53ec\u56de\u7387\u8fbe\u52300.8\u4ee5\u4e0a\u65f6,\u91cd\u5ea6 \u75f4\u5446\u7684\u7cbe\u786e\u7387\u4e0b\u964d\u5e45\u5ea6\u660e\u663e\u2f29\u4e8e\u5176\u4ed6\u9636\u6bb5,\u8fd9\u53cd\u6620\u4e86\u6a21\u578b\u5bf9\u665a\u671f\u75f4\u5446\u75c7\u72b6\u7684\u7279\u5f81\u6355\u6349\u66f4\u4e3a\u51c6 \u786e\u3002\n\n\u4ece\u4e34\u5e8a\u5e94\u2f64\u2ec6\u5ea6\u8003\u91cf,\u8fd9\u4e9bPR\u66f2\u7ebf\u7684\u5206\u6790\u7ed3\u679c\u5177\u6709\u91cd\u8981\u7684\u5b9e\u8df5\u610f\u4e49\u3002\u5728\u75f4\u5446\u75c7\u7684\u65e9\u671f\u7b5b\u67e5\u573a \u666f\u4e2d,\u6211\u4eec\u53ef\u4ee5\u9009\u62e9\u2fbc\u53ec\u56de\u7387\u7684\u2f2f\u4f5c\u70b9(\u59820.8-1.0)\u4ee5\u786e\u4fdd\u5c3d\u53ef\u80fd\u591a\u5730\u8bc6\u522b\u6f5c\u5728\u75c5\u4f8b,\u5c3d\u7ba1\u8fd9\u4f1a \u5e26\u6765\u76f8\u5bf9\u8f83\u591a\u7684\u5047\u9633\u6027,\u4f46\u540e\u7eed\u53ef\u4ee5\u901a\u8fc7\u66f4\u8be6\u7ec6\u7684\u4e34\u5e8a\u8bc4\u4f30\u6392\u9664\u8fd9\u4e9b\u75c5\u4f8b\u3002\u2f7d\u5728\u786e\u8bca\u6216\u6cbb\u7597 \u76d1\u6d4b\u573a\u666f\u4e2d,\u5219\u53ef\u80fd\u9009\u62e9\u4e2d\u7b49\u53ec\u56de\u7387(0.6\u5de6\u53f3)\u7684\u2f2f\u4f5c\u70b9,\u4ee5\u5e73\u8861\u7cbe\u786e\u7387\u548c\u53ec\u56de\u7387,\u51cf\u5c11\u4e0d\u5fc5 \u8981\u7684\u8fdb\u2f00\u6b65\u68c0\u67e5\u3002\u6a21\u578b\u5bf9\u91cd\u5ea6\u75f4\u5446\u7684\u4f18\u5f02\u8bc6\u522b\u80fd\u2f12(AUC=0.95)\u7279\u522b\u9002\u5408\u2f64\u4e8e\u62a4\u7406\u673a\u6784\u4e2d\u7684\u60a3 \u8005\u76d1\u6d4b,\u53ef\u4ee5\u53ca\u65f6\u8bc6\u522b\u75c5\u60c5\u6076\u5316\u7684\u4e2a\u4f53\u5e76\u8c03\u6574\u62a4\u7406\u2f45\u6848\u3002\u76f8\u2f50\u4e4b\u4e0b,\u5bf9\u8f7b\u5ea6\u75f4\u5446\u548c\u4e2d\u5ea6\u75f4\u5446 \u76f8\u5bf9\u7a0d\u5f31\u7684\u533a\u5206\u80fd\u2f12(AUC=0.88)\u63d0\u793a\u6211\u4eec\u5728\u4e34\u5e8a\u5e94\u2f64\u4e2d\u9700\u8981\u7ed3\u5408\u5176\u4ed6\u8bc4\u4f30\u2f2f\u5177\u6765\u786e\u8ba4\u8fd9\u4e9b\u9636 \u6bb5\u7684\u8bca\u65ad\u3002", "mimetype": "text/plain", "start_char_idx": 7913, "end_char_idx": 8825, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}}, "docstore/metadata": {"1260a542-355d-4d34-a165-88fb1d1560fc": {"doc_hash": "7fa690c9904ec25b42096685bdc1e279a7d352ca432ae97aeb8590015cebae5a", "ref_doc_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc"}, "8bfa5e74-a906-428b-83b5-6b4b0992a286": {"doc_hash": "8447f1fbcbf1b80e001e382a70c6c431a5de065154a41e302afbbb41669f839b", "ref_doc_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc"}, "02adfdae-7d3b-4a04-bc34-7dfaa4f45e81": {"doc_hash": "7cc29e91be74fd66959ce28edc213e5b16418568123147d96f62e7af0c91c3a4", "ref_doc_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc"}, "85cecd54-ccee-4d01-9d7e-069bacc091ef": {"doc_hash": "b07cce23d969679017c1e9fa9e62973c1a1b546732a9c9d8f06cc189d3c39820", "ref_doc_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc"}, "62f62bcb-fe45-4b45-9512-8a637f085b2a": {"doc_hash": "6a197cbaa73e87a3b0e373c73dc00043c01e4346cd5f7569d6c8fc66ae5aeac1", "ref_doc_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc"}, "6a653841-0e7f-4471-8b39-09ae0aba6652": {"doc_hash": "0eaeae9b4a4d125a9ce9e50507ae358ce758af8891428542813466cfff06a49b", "ref_doc_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc"}, "9c551fac-eaae-42d7-9d64-c473d133b9c3": {"doc_hash": "9b8e452815a2cad19777d1e4c4d6cde2ef972735e39bf870f63004bbd4e65ff7", "ref_doc_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc"}, "e9776421-05dc-46cd-8de4-5dddc98eaf4f": {"doc_hash": "27505e3abba7dbce469d96d00c80b8b1a543d76a7987efbc16246bc1decd3ac7", "ref_doc_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc"}, "9caf447a-c377-49ae-a7ec-d8f76856868a": {"doc_hash": "7cf3bfbd997d9b6d170eb2a615c2f512eeef47694c62e8ec3240031052631866", "ref_doc_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc"}, "a5016720-3c16-43e7-934d-18d38cf7f8c7": {"doc_hash": "b22d155db786bb2e461831538815712e176c02f5625433bbde98f853cf436fe4", "ref_doc_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc"}, "79b57d73-7ee8-4e09-a312-c6731f20ae64": {"doc_hash": "19038e6ed5a2da91355cbe153fe79abb58a7ec299430d4aedf39f0429789d814", "ref_doc_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc"}, "3743fede-e0af-465c-8255-6ba40e58462d": {"doc_hash": "a52ac373295308b98906fcecfd8220c5ac71b8d2c85051e041a6c4da82799816", "ref_doc_id": "51a76f7e-f1df-4e02-9655-ecc883ebf6fc"}}}